+void testIcons() {
+    EXPECT(codeOf(one(R"({"id":"a","t":"icon","r":[0,0,16,16],"v":"claude","h":2846104221})")) == ErrorCode::None);
+    EXPECT(codeOf(one(R"({"id":"a","t":"icon","r":[0,0,16,16],"v":"claude"})")) == ErrorCode::Field);
+    EXPECT(codeOf(one(R"({"id":"a","t":"icon","r":[0,0,16,16],"v":"claude","h":-1})")) == ErrorCode::Field);
+    EXPECT(codeOf(one(R"({"id":"a","t":"icon","r":[0,0,16,16],"v":"check"})")) == ErrorCode::None);
+    EXPECT(codeOf(one(R"({"id":"a","t":"bar","r":[0,0,100,10],"radius":5,"v":1})")) == ErrorCode::None);
+    EXPECT(codeOf(one(R"({"id":"a","t":"bar","r":[0,0,100,10],"radius":-1,"v":1})")) == ErrorCode::Field);
+
+    // Mono 3x2: alphas 15,0,8 / 1,2,3 -> nibbles F0 81 23
+    const std::array<uint8_t, 8> body = {'S', 'I', 1, 3, 2, 0xF0, 0x81, 0x23};
+    renderer::IconHeader header;
+    uint16_t color = 0;
+    EXPECT(renderer::parseIcon(body.data(), body.size(), header));
+    EXPECT(header.width == 3 && header.height == 2 && header.pixelOffset == 5 && header.totalBytes == 8);
+    EXPECT(renderer::iconPixel(body.data(), header, 0, 0, 0x1234, color) == 255 && color == 0x1234);
+    EXPECT(renderer::iconPixel(body.data(), header, 1, 0, 0x1234, color) == 0);
+    EXPECT(renderer::iconPixel(body.data(), header, 2, 0, 0x1234, color) == 8 * 17);
+    EXPECT(renderer::iconPixel(body.data(), header, 0, 1, 0x1234, color) == 17);
+    EXPECT(renderer::iconPixel(body.data(), header, 2, 1, 0x1234, color) == 3 * 17);
+    EXPECT(!renderer::parseIcon(body.data(), body.size() - 1, header));  // truncated
+    std::array<uint8_t, 8> bad = body;
+    bad[2] = 3;
+    EXPECT(!renderer::parseIcon(bad.data(), bad.size(), header));  // unknown format
+    bad = body;
+    bad[3] = 25;
+    EXPECT(!renderer::parseIcon(bad.data(), bad.size(), header));  // too wide
+
+    // Palette 2x2, 2 entries: red opaque, green half; indices 0,1 / 1,5 (5 is outside the palette)
+    const std::array<uint8_t, 14> colour = {'S', 'I', 2, 2, 2, 2, 0xF8, 0x00, 255, 0x07, 0xE0, 128, 0x01, 0x15};
+    EXPECT(renderer::parseIcon(colour.data(), colour.size(), header));
+    EXPECT(header.format == 2 && header.paletteCount == 2 && header.pixelOffset == 12 && header.totalBytes == 14);
+    EXPECT(renderer::iconPixel(colour.data(), header, 0, 0, 0xFFFF, color) == 255 && color == 0xF800);
+    EXPECT(renderer::iconPixel(colour.data(), header, 1, 0, 0xFFFF, color) == 128 && color == 0x07E0);
+    EXPECT(renderer::iconPixel(colour.data(), header, 0, 1, 0xFFFF, color) == 128 && color == 0x07E0);
+    EXPECT(renderer::iconPixel(colour.data(), header, 1, 1, 0xFFFF, color) == 0);
+    std::array<uint8_t, 14> noPalette = colour;
+    noPalette[5] = 17;
+    EXPECT(!renderer::parseIcon(noPalette.data(), noPalette.size(), header));
+    EXPECT(!renderer::parseIcon(colour.data(), colour.size() - 1, header));
+
+    std::array<char, 96> url{};
+    EXPECT(renderer::iconUrl("http://192.0.2.10:8765/v1/display", "claude", url.data(), url.size()));
+    EXPECT(std::strcmp(url.data(), "http://192.0.2.10:8765/v1/icon/claude") == 0);
+    EXPECT(renderer::iconUrl("http://pc/x/v1/display?k=1", "a b/c", url.data(), url.size()));
+    EXPECT(std::strcmp(url.data(), "http://pc/x/v1/icon/a%20b%2Fc") == 0);
+    EXPECT(!renderer::iconUrl("http://pc/metrics", "claude", url.data(), url.size()));
+    std::array<char, 12> small{};
+    EXPECT(!renderer::iconUrl("http://pc/v1/display", "claude", small.data(), small.size()));
+}
