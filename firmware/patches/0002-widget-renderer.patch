+// Fake socket for the bounded reader: serves a fixed body, like a Stream with readBytes()
+struct FakeStream {
+    std::string body;
+    size_t pos = 0;
+    auto readBytes(char* buffer, size_t length) -> size_t {
+        size_t count = 0;
+        while (count < length && pos < body.size()) {
+            buffer[count++] = body[pos++];
+        }
+        return count;
+    }
+};
+
+void testBoundedReader() {
+    FakeStream stream{R"({"proto":1,"w":[]})"};
+    renderer::BoundedReader<FakeStream> exact(stream, stream.body.size());
+    JsonDocument doc;
+    EXPECT(!deserializeJson(doc, exact));
+
+    // Content-Length shorter than the JSON: the parser must stop at the limit
+    FakeStream lying{R"({"proto":1,"w":[]})"};
+    renderer::BoundedReader<FakeStream> capped(lying, 8);
+    EXPECT(deserializeJson(doc, capped) == DeserializationError::IncompleteInput);
+    EXPECT(lying.pos == 8);
+}
