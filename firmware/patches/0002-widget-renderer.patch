+    EXPECT(codeOf(one(R"({"id":"a","t":"text","r":[0,0,10,10],"text":"0123456789012345678901234567890"})")) ==
+           ErrorCode::None);
+    EXPECT(codeOf(one(R"({"id":"a","t":"text","r":[0,0,10,10],"text":"01234567890123456789012345678901"})")) ==
+           ErrorCode::String);
+    // 31 characters, some multi-byte: still fine
+    EXPECT(codeOf(one(R"({"id":"a","t":"text","r":[0,0,10,10],"v":"°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°°"})")) ==
+           ErrorCode::None);
+
+    // Segments and bars limits
+    EXPECT(codeOf(one(R"({"id":"a","t":"bar","r":[0,0,100,10],"v":[[1,"#ffffff"],[1,"#ffffff"],[1,"#ffffff"],[1,"#ffffff"]]})")) ==
+           ErrorCode::None);
+    EXPECT(codeOf(one(R"({"id":"a","t":"bar","r":[0,0,100,10],"v":[[1,"#ffffff"],[1,"#ffffff"],[1,"#ffffff"],[1,"#ffffff"],[1,"#ffffff"]]})")) ==
+           ErrorCode::Value);
+    EXPECT(codeOf(one(R"({"id":"a","t":"bar","r":[0,0,100,10],"v":[5,"#ffffff"]})")) == ErrorCode::None);
+    EXPECT(codeOf(one(R"({"id":"a","t":"bar","r":[0,0,100,10],"v":"5"})")) == ErrorCode::Value);
+    EXPECT(codeOf(one(R"({"id":"a","t":"bar","r":[0,0,100,10],"v":null})")) == ErrorCode::None);
+    EXPECT(codeOf(one(R"({"id":"a","t":"ring","r":[0,0,100,100],"max":0,"v":1})")) == ErrorCode::Field);
+    EXPECT(codeOf(one(R"({"id":"a","t":"ring","r":[0,0,100,100],"show":"all","v":1})")) == ErrorCode::Field);
+    std::string bars = R"({"id":"a","t":"bars","r":[0,0,100,10],"v":[)";
+    for (int i = 0; i < 33; ++i) {
+        bars += (i == 0 ? "1" : ",1");
+    }
+    EXPECT(codeOf(one(bars + "]}")) == ErrorCode::Value);
+    EXPECT(codeOf(one(R"({"id":"a","t":"bars","r":[0,0,100,10],"v":[1,null,[2,"#ff0000"],[[1,"#ffffff"]]]})")) ==
+           ErrorCode::None);
+    std::string spark = R"({"id":"a","t":"spark","r":[0,0,100,10],"v":[)";
+    for (int i = 0; i < 121; ++i) {
+        spark += (i == 0 ? "1" : ",1");
