diff --git a/scripts/make_vlw.py b/scripts/make_vlw.py
new file mode 100644
index 0000000..ef3bb85
--- /dev/null
+++ b/scripts/make_vlw.py
@@ -0,0 +1,103 @@
+#!/usr/bin/env python3
+# SPDX-License-Identifier: GPL-3.0-or-later
+"""Generate a TFT_eSPI smooth-font (Processing .vlw) C array from a TrueType font.
+
+Reproducible: same TTF + size + charset -> byte-identical output (needs Pillow).
+
+    python3 scripts/make_vlw.py /usr/share/fonts/truetype/noto/NotoSansMono-Bold.ttf 20 \
+        NotoSansMonoBold20 src/renderer/fonts/NotoSansMonoBold20.h
+
+VLW layout as read by TFT_eSPI (Extensions/Smooth_font.cpp, loadFont/loadMetrics), all big-endian int32:
+  header (24 B): glyph count, version (11), size, mboxY (0), ascent (top of 'd'), descent (bottom of 'p')
+  per glyph (28 B): unicode, height, width, xAdvance, dY (baseline to bitmap top, +up), dX (cursor to
+                    bitmap left), padding (0)
+  bitmaps: width*height bytes of 8-bit alpha per glyph, in glyph order
+  tail: font name strings + smoothing flag (ignored by TFT_eSPI, kept for Processing compatibility)
+U+0020 is stored as an empty glyph so the renderer can read its true advance (TFT_eSPI otherwise
+guesses the space width, which breaks column alignment in a monospaced font).
+"""
+import argparse
+import struct
+import sys
+
+from PIL import ImageFont
+
+DEFAULT_CHARSET = list(range(0x20, 0x7F)) + [0xB0]
+
+
+def glyph(font, code):
+    ch = chr(code)
+    advance = int(round(font.getlength(ch)))
+    if ch.isspace():
+        return code, 0, 0, advance, 0, 0, b""
+    mask, (off_x, off_y) = font.getmask2(ch, mode="L", anchor="ls")
+    box = mask.getbbox()
+    if box is None:
+        return code, 0, 0, advance, 0, 0, b""
+    left, top, right, bottom = box
+    width, height = right - left, bottom - top
+    pixels = bytes(mask.getpixel((x, y)) for y in range(top, bottom) for x in range(left, right))
+    # off_y is the bitmap top relative to the baseline (negative = above)
+    return code, height, width, advance, -(off_y + top), off_x + left, pixels
+
+
+def build(ttf, size, charset):
+    font = ImageFont.truetype(ttf, size)
+    glyphs = [glyph(font, c) for c in sorted(set(charset))]
+    by_code = {g[0]: g for g in glyphs}
+    ascent = by_code[ord("d")][4] if ord("d") in by_code else size
+    p = by_code.get(ord("p"))
+    descent = (p[1] - p[4]) if p else 0
+    out = bytearray(struct.pack(">6i", len(glyphs), 11, size, 0, ascent, descent))
+    for code, height, width, advance, dy, dx, _ in glyphs:
+        out += struct.pack(">7i", code, height, width, advance, dy, dx, 0)
+    for g in glyphs:
+        out += g[6]
+    family, style = font.getname()
+    full = f"{family} {style}".encode()
+    ps = f"{family.replace(' ', '')}-{style}".encode()
+    out += bytes([0, len(full)]) + full + bytes([0, len(ps)]) + ps + b"\x01"
+    return bytes(out)
+
+
+def to_header(name, data, ttf, size):
+    lines = [
+        "// Generated by scripts/make_vlw.py, do not edit.",
+        f"// Source: {ttf.rsplit('/', 1)[-1]}, size {size}, U+0020-U+007E and U+00B0.",
+        "// Font licence: SIL Open Font License 1.1 (Noto fonts).",
+        "#pragma once",
+        "",
+        "#include <pgmspace.h>",
+        "#include <stdint.h>",
+        "",
+        "// NOLINTNEXTLINE(modernize-avoid-c-arrays)",
+        f"const uint8_t {name}[] PROGMEM = {{",
+    ]
+    for i in range(0, len(data), 16):
+        lines.append("    " + ", ".join(f"0x{b:02X}" for b in data[i : i + 16]) + ",")
+    lines.append("};")
+    return "\n".join(lines) + "\n"
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("ttf")
+    ap.add_argument("size", type=int)
+    ap.add_argument("name", help="C array name")
+    ap.add_argument("out", help="output .h path, or - for stdout")
+    ap.add_argument("--raw", action="store_true", help="write the raw .vlw bytes instead of a C header")
+    args = ap.parse_args()
+    data = build(args.ttf, args.size, DEFAULT_CHARSET)
+    if args.raw:
+        (sys.stdout.buffer if args.out == "-" else open(args.out, "wb")).write(data)
+        return
+    text = to_header(args.name, data, args.ttf, args.size)
+    if args.out == "-":
+        sys.stdout.write(text)
+    else:
+        with open(args.out, "w", encoding="ascii") as f:
+            f.write(text)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/src/dashboard/DashboardManager.cpp b/src/dashboard/DashboardManager.cpp
index 5230bb4..c68e231 100644
--- a/src/dashboard/DashboardManager.cpp
+++ b/src/dashboard/DashboardManager.cpp
@@ -13,6 +13,8 @@
 namespace {
 constexpr uint32_t FETCH_INTERVAL_MS = 1000;
 constexpr uint16_t FETCH_TIMEOUT_MS = 800;
+// A single lost poll (Wi-Fi retry, slow reply) must not flash the full-screen offline view
+constexpr uint8_t OFFLINE_AFTER_FAILURES = 3;
 constexpr size_t TILE_COUNT = 6;
