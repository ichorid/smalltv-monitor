+
+void testUnderSeries() {
+    const auto spark = [](const std::string& extra) {
+        return one(R"({"id":"s","t":"spark","r":[0,0,100,20],"c":"#3fb950","fill":"#3fb950","v":[1,50,99])" + extra +
+                   "}");
+    };
+    EXPECT(codeOf(spark(R"(,"u":[5,80,2],"uc":"#f2384c")")) == ErrorCode::None);
+    EXPECT(codeOf(spark(R"(,"u":[5,80])")) == ErrorCode::None);  // lengths may differ, `uc` optional
+    EXPECT(codeOf(spark(R"(,"u":[])")) == ErrorCode::None);
+    EXPECT(codeOf(spark(R"(,"u":[1,"x"])")) == ErrorCode::Value);
+    EXPECT(codeOf(spark(R"(,"u":"#f2384c")")) == ErrorCode::Value);
+    EXPECT(codeOf(spark(R"(,"u":[1],"uc":"red")")) == ErrorCode::Color);
+    EXPECT(codeOf(spark(R"(,"u":[1],"grad":[[0,"#000000"],[100,"#ffffff"]])")) == ErrorCode::Field);
+    std::string many = R"(,"u":[)";
+    for (size_t i = 0; i <= renderer::MAX_SPARK; ++i) {
+        many += (i == 0 ? "1" : ",1");
+    }
+    EXPECT(codeOf(spark(many + "]")) == ErrorCode::Value);
+    // Only `u`: valid (the main series may be empty)
+    EXPECT(codeOf(one(R"({"id":"s","t":"spark","r":[0,0,100,20],"v":null,"u":[1,2]})")) == ErrorCode::None);
+}
