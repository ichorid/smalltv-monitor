+void testHelpers() {
+    uint16_t color = 0;
+    EXPECT(renderer::parseColor("#ffffff", color) && color == 0xFFFF);
+    EXPECT(renderer::parseColor("#FF0000", color) && color == 0xF800);
+    EXPECT(renderer::parseColor("#8b949e", color) && color == renderer::DEFAULT_LABEL);
+    EXPECT(renderer::parseColor("#1c2128", color) && color == renderer::DEFAULT_TRACK);
+    EXPECT(!renderer::parseColor("ffffff", color));
+    EXPECT(!renderer::parseColor("#fffffff", color));
+    EXPECT(!renderer::parseColor(nullptr, color));
+
+    std::array<char, 16> buf{};
+    renderer::formatNumber(51, 0, buf.data(), buf.size());
+    EXPECT(std::strcmp(buf.data(), "51") == 0);
+    renderer::formatNumber(27.15, 1, buf.data(), buf.size());
+    EXPECT(std::strcmp(buf.data(), "27.2") == 0 || std::strcmp(buf.data(), "27.1") == 0);
+    renderer::formatNumber(-0.04, 1, buf.data(), buf.size());
+    EXPECT(std::strcmp(buf.data(), "0.0") == 0);
+    renderer::formatNumber(-3.5, 2, buf.data(), buf.size());
+    EXPECT(std::strcmp(buf.data(), "-3.50") == 0);
+    renderer::formatNumber(0.05, 2, buf.data(), buf.size());
+    EXPECT(std::strcmp(buf.data(), "0.05") == 0);
+    renderer::formatNumber(1e12, 0, buf.data(), buf.size());
+    EXPECT(std::strcmp(buf.data(), "--") == 0);
+    std::array<char, 4> tiny{};
+    renderer::formatNumber(12345, 0, tiny.data(), tiny.size());
+    EXPECT(std::strlen(tiny.data()) == 3);
+
+    const char* text = "51°C";
+    EXPECT(renderer::utf8Length(text) == 4);
+    const char* cursor = text + 2;
+    EXPECT(renderer::decodeUtf8(cursor) == 0xB0);
+    const char* broken = "\xC2";
+    EXPECT(renderer::decodeUtf8(broken) == 0xFFFD);
+
+    const auto ring = renderer::ringGeometry({16, 26, 92, 92});
+    EXPECT(ring.cx == 62 && ring.cy == 72 && ring.radius == 45 && ring.thickness == 9);
+    EXPECT(ring.labelY == 72 + 32);  // round(72 + 0.72 * 45 = 104.4)
+    const auto small = renderer::ringGeometry({0, 0, 40, 50});
+    EXPECT(small.thickness == 6 && small.radius == 19 && small.cy == 25);
+
+    EXPECT(renderer::scaleLength(50, 100, 200) == 100);
+    EXPECT(renderer::scaleLength(150, 100, 200) == 200);
+    EXPECT(renderer::scaleLength(-5, 100, 200) == 0);
+    EXPECT(renderer::scaleLength(5, 0, 200) == 0);
+
+    // 16 bars over 224 px with a gap of 2: floor((224 - 30) / 16) = 12
+    auto slot = renderer::barSlot(224, 2, 16, 15);
+    EXPECT(slot.length == 12 && slot.start == 15 * 14);
+    slot = renderer::barSlot(10, 2, 8, 0);
+    EXPECT(slot.length == 0);
+
+    const renderer::Rect rect{8, 186, 224, 24};
+    EXPECT(renderer::sparkX(0, 15, rect) == 8.0F);
+    EXPECT(renderer::sparkX(14, 15, rect) == 231.0F);
+    EXPECT(renderer::sparkY(0, 0, 100, rect) == 209.0F);
+    EXPECT(renderer::sparkY(100, 0, 100, rect) == 186.0F);
+    EXPECT(renderer::sparkY(500, 0, 100, rect) == 186.0F);
+
+    JsonDocument doc;
+    deserializeJson(doc, R"([[24,"#fd8c00"],[9,"#f2384c"]])");
+    renderer::Segments segments;
+    EXPECT(renderer::readSegments(doc.as<JsonVariantConst>(), 0, segments));
+    EXPECT(segments.count == 2 && renderer::total(segments) == 33.0F && segments.items[1].color == 0xF1C9);
+}
