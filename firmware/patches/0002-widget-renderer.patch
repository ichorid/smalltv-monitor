+void testRejections() {
+    EXPECT(codeOf(R"({"w":[]})") == ErrorCode::Proto);
+    EXPECT(codeOf(R"({"proto":2,"w":[]})") == ErrorCode::Proto);
+    EXPECT(codeOf(R"({"proto":1})") == ErrorCode::Widgets);
+    EXPECT(codeOf(R"({"proto":1,"w":[]})") == ErrorCode::None);
+    EXPECT(codeOf(R"({"proto":1,"screen":{"bri":101},"w":[]})") == ErrorCode::Screen);
+    EXPECT(codeOf(R"({"proto":1,"screen":{"bg":"red"},"w":[]})") == ErrorCode::Screen);
+    EXPECT(codeOf(R"({"proto":1,"screen":{"poll_ms":0},"w":[]})") == ErrorCode::Screen);
+    Frame clamped;
+    validate(R"({"proto":1,"screen":{"poll_ms":10},"w":[]})", clamped);
+    EXPECT(clamped.screen.pollMs == renderer::MIN_POLL_MS);
+
+    EXPECT(codeOf(one(R"({"t":"text","r":[0,0,10,10]})")) == ErrorCode::Id);
+    EXPECT(codeOf(one(R"({"id":"","t":"text","r":[0,0,10,10]})")) == ErrorCode::Id);
+    EXPECT(codeOf(one(R"({"id":"a","t":"text","r":[0,0,10,10]},{"id":"a","t":"text","r":[20,0,10,10]})")) ==
+           ErrorCode::Id);
+    EXPECT(codeOf(one(R"({"id":"a","t":"clock","r":[0,0,10,10]})")) == ErrorCode::Type);
+    EXPECT(codeOf(one(R"({"id":"a","t":"text","r":[0,0,10]})")) == ErrorCode::Rect);
+    EXPECT(codeOf(one(R"({"id":"a","t":"text","r":[231,0,10,10]})")) == ErrorCode::Rect);
+    EXPECT(codeOf(one(R"({"id":"a","t":"text","r":[230,230,10,10]})")) == ErrorCode::None);
+    EXPECT(codeOf(one(R"({"id":"a","t":"text","r":[-1,0,10,10]})")) == ErrorCode::Rect);
+    EXPECT(codeOf(one(R"({"id":"a","t":"text","r":[0,0,0,10]})")) == ErrorCode::Rect);
+    EXPECT(codeOf(one(R"({"id":"a","t":"text","r":[0,0,1.5,10]})")) == ErrorCode::Rect);
+    EXPECT(codeOf(one(R"({"id":"a","t":"text","r":[0,0,10,10]},{"id":"b","t":"text","r":[9,9,10,10]})")) ==
+           ErrorCode::Overlap);
+    EXPECT(codeOf(one(R"({"id":"a","t":"text","r":[0,0,10,10]},{"id":"b","t":"text","r":[10,10,10,10]})")) ==
+           ErrorCode::None);
+    EXPECT(codeOf(one(R"({"id":"a","t":"text","r":[0,0,10,10],"f":3})")) == ErrorCode::Font);
+    EXPECT(codeOf(one(R"({"id":"a","t":"text","r":[0,0,10,10],"c":"#fff"})")) == ErrorCode::Color);
