+#!/usr/bin/env bash
+# Host-side test of the renderer's pure logic (validation, hashing, change detection, geometry).
+# Needs g++ and an ArduinoJson checkout (fetched by any `pio run`); not a PlatformIO test suite.
+set -euo pipefail
+root="$(cd "$(dirname "$0")/../.." && pwd)"
+json="${ARDUINOJSON_SRC:-}"
+if [[ -z "$json" ]]; then
+    json="$(find "$root/.pio/libdeps" -path '*/ArduinoJson/src' -type d 2>/dev/null | head -n1)"
+fi
+[[ -d "$json" ]] || { echo "ArduinoJson not found: run 'pio run -e renderer' first or set ARDUINOJSON_SRC" >&2; exit 2; }
+out="$(mktemp -d)"
+trap 'rm -rf "$out"' EXIT
+# -Wno-maybe-uninitialized: GCC false positive inside ArduinoJson iterators when inlined under ASan
+g++ -std=c++17 -Wall -Wextra -Wpedantic -Werror -Wno-maybe-uninitialized -O1 -fsanitize=address,undefined \
+    -I"$root/include" -isystem "$json" \
+    "$root/src/renderer/WidgetModel.cpp" "$root/test/host/widget_model_test.cpp" -o "$out/widget_model_test"
+"$out/widget_model_test"
