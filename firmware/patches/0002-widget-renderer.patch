+// SPDX-License-Identifier: GPL-3.0-or-later
+// Widget drawing for the /v1/display renderer. Geometry follows the protocol's rendering conventions
+// (docs/WIDGET-PROTOCOL.md) so the PC-side preview and the device agree.
+#ifdef DISPLAY_URL
+#include "renderer/WidgetPainter.h"
+
+#include <Arduino.h>
+#include <Logger.h>
+// TFT_eSPI's smooth-font header references the deprecated SPIFFS object (font files, unused here)
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wdeprecated-declarations"
+#include <TFT_eSPI.h>
+#pragma GCC diagnostic pop
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdlib>
+#include <cstring>
+
+#include "display/DisplayManager.h"
+#include "renderer/Fonts.h"
+#include "renderer/IconCache.h"
+
+namespace renderer {
+
+namespace {
+
+constexpr size_t TEXT_BUFFER_SIZE = 192;  // 62 characters (value + unit) of up to 3 UTF-8 bytes
+constexpr int16_t BAR_LABEL_W = 48;
+constexpr int16_t BAR_LABEL_H = 16;
+constexpr int16_t RING_LABEL_H = 16;
+constexpr uint8_t RING_DEFAULT_FONT = 1;
+constexpr int RING_NUMBER_HALF = 20;  // half height of the number band: fits font 1 (the tallest, 37 px cells)
+constexpr float DEFAULT_MAX = 100.0F;
+// TFT_eSPI arcs: 0 deg = 6 o'clock, clockwise. The protocol's 135..405 deg (0 = 3 o'clock) is 45..315 here.
+constexpr int16_t ARC_START = 45;
+constexpr int16_t ARC_SWEEP = 270;
+constexpr float SPARK_LINE_W = 2.0F;
+constexpr uint32_t FONT_HEAP_NEEDED = 2048;  // glyph metric tables: ~12 B per glyph, 7 allocations
+constexpr uint32_t FONT_BLOCK_NEEDED = 512;  // largest of them: 4 B per glyph
+constexpr uint16_t OFFLINE_RED = 0xF800;
+constexpr uint16_t SPACE = 0x20;
+constexpr uint32_t MAX_BMP_CODE = 0xFFFF;
+constexpr size_t YIELD_EVERY = 8;
+constexpr int SPARK_YIELD_COLUMNS = 32;
+constexpr float SUBPIXELS = 16.0F;  // sample y stored in 1/16 px
+constexpr int MAX_PERCENT = 100;
+
+TFT_eSPI* tft = nullptr;
+int loadedFont = -1;
+Rect currentClip{0, 0, SCREEN_W, SCREEN_H};
+
+const std::array<const uint8_t*, FONT_COUNT> FONTS = {NotoSansBold15, NotoSansBold36, NotoSansMonoBold20};
+
+using TextBuffer = std::array<char, TEXT_BUFFER_SIZE>;
+
+auto intersect(const Rect& first, const Rect& second) -> Rect {
+    const int left = std::max(first.x, second.x);
+    const int top = std::max(first.y, second.y);
+    const int right = std::min(first.x + first.w, second.x + second.w);
+    const int bottom = std::min(first.y + first.h, second.y + second.h);
+    return Rect{static_cast<int16_t>(left), static_cast<int16_t>(top), static_cast<int16_t>(std::max(0, right - left)),
+                static_cast<int16_t>(std::max(0, bottom - top))};
+}
+
+// Restricts drawing to a rect (nested scopes intersect) and restores the previous clip on exit
+class ClipScope {
+   public:
+    explicit ClipScope(const Rect& rect) : m_saved(currentClip) { apply(intersect(rect, currentClip)); }
+    ~ClipScope() { apply(m_saved); }
+    ClipScope(const ClipScope&) = delete;
+    ClipScope(ClipScope&&) = delete;
+    auto operator=(const ClipScope&) -> ClipScope& = delete;
+    auto operator=(ClipScope&&) -> ClipScope& = delete;
+
+   private:
+    static auto apply(const Rect& rect) -> void {
+        currentClip = rect;
+        tft->setViewport(rect.x, rect.y, rect.w, rect.h, false);
+    }
+    Rect m_saved;
+};
+
+auto fillPart(int left, int top, int width, int height, uint16_t color) -> void {
+    if (width > 0 && height > 0) {
+        tft->fillRect(left, top, width, height, color);
+    }
+}
+
+auto releaseFont() -> void {
+    if (loadedFont >= 0) {
+        tft->unloadFont();
+        loadedFont = -1;
+    }
+}
+
+// Fonts stay loaded for the rest of the pass; switching costs a reload (~1.2 KB of metric tables)
+auto useFont(uint8_t index) -> bool {
+    const int wanted = index < FONT_COUNT ? index : 0;
+    if (loadedFont == wanted) {
+        return true;
+    }
+    releaseFont();
+    // TFT_eSPI does not check its mallocs when loading a font
+    // NOLINTNEXTLINE(readability-static-accessed-through-instance)
+    if (ESP.getFreeHeap() < FONT_HEAP_NEEDED || ESP.getMaxFreeBlockSize() < FONT_BLOCK_NEEDED) {
+        return false;
+    }
+    tft->loadFont(FONTS[wanted]);
+    loadedFont = wanted;
+    // A stored U+0020 glyph gives the real space advance (TFT_eSPI guesses one otherwise)
+    uint16_t glyph = 0;
+    if (tft->getUnicodeIndex(SPACE, &glyph)) {
+        tft->gFont.spaceWidth = tft->gxAdvance[glyph];
+    }
+    return true;
+}
+
+auto appendUtf8(uint32_t code, TextBuffer& out, size_t& length) -> bool {
+    // NOLINTBEGIN(readability-magic-numbers): UTF-8 encoding
+    std::array<char, 3> bytes{};
+    size_t count = 0;
+    if (code < 0x80U) {
+        bytes[count++] = static_cast<char>(code);
+    } else if (code < 0x800U) {
+        bytes[count++] = static_cast<char>(0xC0U | (code >> 6U));
+        bytes[count++] = static_cast<char>(0x80U | (code & 0x3FU));
+    } else {
+        bytes[count++] = static_cast<char>(0xE0U | (code >> 12U));
+        bytes[count++] = static_cast<char>(0x80U | ((code >> 6U) & 0x3FU));
+        bytes[count++] = static_cast<char>(0x80U | (code & 0x3FU));
+    }
+    // NOLINTEND(readability-magic-numbers)
+    if (length + count >= out.size()) {
+        return false;
+    }
+    for (size_t i = 0; i < count; ++i) {
+        out[length++] = bytes[i];
+    }
+    out[length] = '\0';
+    return true;
+}
+
+struct PreparedText {
+    TextBuffer text{};
+    int advance = 0;  // sum of glyph advances, i.e. the extent of the cells TFT_eSPI paints
+};
+
+// Keeps only the glyphs the loaded font has (TFT_eSPI would draw a box for the others)
+auto prepare(const char* source, PreparedText& out) -> void {
+    size_t length = 0;
+    out.text[0] = '\0';
+    out.advance = 0;
+    const char* cursor = source != nullptr ? source : "";
+    for (uint32_t code = decodeUtf8(cursor); code != 0; code = decodeUtf8(cursor)) {
+        uint16_t glyph = 0;
+        int width = 0;
+        if (code == SPACE) {
+            width = tft->gFont.spaceWidth;
+        } else if (code <= MAX_BMP_CODE && tft->getUnicodeIndex(static_cast<uint16_t>(code), &glyph)) {
+            width = tft->gxAdvance[glyph];
+        } else {
+            continue;
+        }
+        if (!appendUtf8(code, out.text, length)) {
+            break;
+        }
+        out.advance += width;
+    }
+}
+
+// Draws one line of text in `rect` without a blank frame: the strips around the text are filled first, then
+// the glyph cells are drawn with their own background
+auto drawTextIn(const Rect& rect, const char* text, uint8_t font, uint16_t color, uint16_t background, char align)
+    -> void {
+    ClipScope clip(rect);
+    if (!useFont(font)) {
+        fillPart(rect.x, rect.y, rect.w, rect.h, background);
+        return;
+    }
+    PreparedText prepared;
+    prepare(text, prepared);
+    const int width = prepared.text[0] == '\0' ? 0 : tft->textWidth(prepared.text.data());
+    const int height = tft->fontHeight();
+    int left = rect.x;
+    if (align == 'c') {
+        left = rect.x + (rect.w - width) / 2;
+    } else if (align == 'r') {
+        left = rect.x + rect.w - width;
+    }
+    const int top = rect.y + (rect.h - height) / 2;
+    const int cellsRight = left + std::min(prepared.advance, width);
+    const int rectRight = rect.x + rect.w;
+    const int rectBottom = rect.y + rect.h;
+    fillPart(rect.x, rect.y, rect.w, top - rect.y, background);
+    fillPart(rect.x, top + height, rect.w, rectBottom - (top + height), background);
+    fillPart(rect.x, top, left - rect.x, height, background);
+    fillPart(cellsRight, top, rectRight - cellsRight, height, background);
+    if (width > 0) {
+        tft->setTextColor(color, background, true);
+        tft->setTextDatum(TL_DATUM);
+        tft->drawString(prepared.text.data(), left, top);
+    }
+}
+
+struct Widget {
+    JsonObjectConst obj;
+    Rect rect;
+    uint16_t bg = 0;
+    uint16_t color = DEFAULT_FG;
+    uint8_t font = 0;
+};
+
+// ArduinoJson's operator[] (obj["key"]) is misreported by readability-misplaced-array-index under `pio check`,
+// whose clang-tidy cannot find its resource headers and parses ArduinoJson in error recovery (a correct parse
+// shows CXXOperatorCallExpr). Upstream suppresses the same check on these accesses.
+// NOLINTBEGIN(readability-misplaced-array-index)
+auto alignOf(JsonObjectConst obj) -> char {
+    const char* align = obj["a"] | "l";
+    return align[0];
+}
+
+auto drawText(const Widget& widget) -> void {
+    const JsonVariantConst value = widget.obj["v"];
+    const char* text = value.is<const char*>() ? value.as<const char*>() : (widget.obj["text"] | "");
+    drawTextIn(widget.rect, text, widget.font, widget.color, widget.bg, alignOf(widget.obj));
+}
+
+auto drawValue(const Widget& widget) -> void {
+    TextBuffer raw{};
+    JsonVariantConst value = widget.obj["v"];
+    uint16_t color = widget.color;
+    if (value.is<JsonArrayConst>()) {  // [value, "#colour"]
+        color = colorOr(value[1], color);
+        value = value[0];
+    }
+    if (value.isNull()) {
+        std::strncpy(raw.data(), "--", raw.size() - 1);
+    } else {
+        if (value.is<const char*>()) {
+            std::strncpy(raw.data(), value.as<const char*>(), raw.size() - 1);
+        } else {
+            formatNumber(value.as<double>(), widget.obj["dp"] | 0, raw.data(), raw.size());
+        }
+        const char* unit = widget.obj["unit"] | "";
+        std::strncat(raw.data(), unit, raw.size() - std::strlen(raw.data()) - 1);
+    }
+    const char* label = widget.obj["label"];
+    if (label == nullptr) {
+        drawTextIn(widget.rect, raw.data(), widget.font, color, widget.bg, alignOf(widget.obj));
+        return;
+    }
+    // With a label: label left-aligned in `lc`, value right-aligned in the space it needs; both in font `f`
+    int valueWidth = 0;
+    if (useFont(widget.font)) {
+        PreparedText prepared;
+        prepare(raw.data(), prepared);
+        valueWidth = prepared.text[0] == '\0' ? 0 : std::min<int>(tft->textWidth(prepared.text.data()), widget.rect.w);
+    }
+    const Rect& rect = widget.rect;
+    const auto labelWidth = static_cast<int16_t>(rect.w - valueWidth);
+    drawTextIn(Rect{rect.x, rect.y, labelWidth, rect.h}, label, widget.font, colorOr(widget.obj["lc"], DEFAULT_LABEL),
+               widget.bg, 'l');
+    drawTextIn(Rect{static_cast<int16_t>(rect.x + labelWidth), rect.y, static_cast<int16_t>(valueWidth), rect.h},
+               raw.data(), widget.font, color, widget.bg, 'r');
+}
+
+// The part [start, stop) of a bar along its fill direction (from the left, or from the bottom when vertical)
+auto barPart(const Rect& bar, bool vertical, int start, int stop) -> Rect {
+    return vertical ? Rect{bar.x, static_cast<int16_t>(bar.y + bar.h - stop), bar.w, static_cast<int16_t>(stop - start)}
+                    : Rect{static_cast<int16_t>(bar.x + start), bar.y, static_cast<int16_t>(stop - start), bar.h};
+}
+
+// Draws `shape` (rounded by `radius`) clipped to `part`; square shapes are a plain fill of the part
+auto paintClipped(const Rect& shape, int16_t radius, const Rect& part, uint16_t color, uint16_t background) -> void {
+    if (part.w <= 0 || part.h <= 0) {
+        return;
+    }
+    if (radius <= 0) {
+        const Rect clipped = intersect(shape, part);
+        fillPart(clipped.x, clipped.y, clipped.w, clipped.h, color);
+        return;
+    }
+    const ClipScope clip(part);
+    tft->fillSmoothRoundRect(shape.x, shape.y, shape.w, shape.h, radius, color, background);
+}
+
+// Single value with rounded corners: a rounded fill of length `fill` over the rounded track. Painted in
+// three parts so nothing blanks: fill body, the fill's rounded end over the track, then the rest of the track.
+auto paintRoundedFill(const Rect& bar, int16_t radius, bool vertical, int fill, uint16_t color, uint16_t track,
+                      uint16_t background) -> void {
+    const int length = vertical ? bar.h : bar.w;
+    const Rect fillShape = barPart(bar, vertical, 0, fill);
+    const int knee = std::max(0, fill - radius);
+    paintClipped(fillShape, radius, barPart(bar, vertical, 0, knee), color, background);
+    if (fill > knee) {
+        const Rect end = barPart(bar, vertical, knee, fill);
+        paintClipped(bar, radius, end, track, background);
+        paintClipped(fillShape, radius, end, color, track);
+    }
+    paintClipped(bar, radius, barPart(bar, vertical, fill, length), track, background);
+}
+
+// Track uses `radius`; one value is filled with the same radius; two or more segments are square
+auto paintBar(const Rect& bar, int16_t radius, bool vertical, const Segments& segments, float max, uint16_t track,
+              uint16_t background) -> void {
+    const auto length = static_cast<int16_t>(vertical ? bar.h : bar.w);
+    if (radius > 0 && segments.count == 1) {
+        paintRoundedFill(bar, radius, vertical, scaleLength(segments.items[0].value, max, length),
+                         segments.items[0].color, track, background);
+        return;
+    }
+    int position = 0;
+    float sum = 0;
+    for (size_t i = 0; i < segments.count; ++i) {
+        sum += segments.items[i].value;
+        const int end = scaleLength(sum, max, length);
+        if (end > position) {
+            paintClipped(bar, 0, barPart(bar, vertical, position, end), segments.items[i].color, background);
+            position = end;
+        }
+    }
+    paintClipped(bar, radius, barPart(bar, vertical, position, length), track, background);
+}
+
+auto drawBar(const Widget& widget) -> void {
+    const JsonObjectConst obj = widget.obj;
+    const Rect& rect = widget.rect;
+    const bool vertical = std::strcmp(obj["dir"] | "h", "v") == 0;
+    const char* label = obj["label"];
+    Segments segments;
+    readSegments(obj["v"], widget.color, segments);
+    Rect bar = rect;
+    if (label != nullptr) {
+        Rect labelRect = vertical ? Rect{rect.x, static_cast<int16_t>(rect.y + rect.h - BAR_LABEL_H), rect.w,
+                                         BAR_LABEL_H}
+                                  : Rect{rect.x, rect.y, BAR_LABEL_W, rect.h};
+        labelRect = intersect(labelRect, rect);
+        drawTextIn(labelRect, label, 0, colorOr(obj["lc"], DEFAULT_LABEL), widget.bg, vertical ? 'c' : 'l');
+        bar = vertical ? Rect{rect.x, rect.y, rect.w, static_cast<int16_t>(rect.h - BAR_LABEL_H)}
+                       : Rect{static_cast<int16_t>(rect.x + BAR_LABEL_W), rect.y,
+                              static_cast<int16_t>(rect.w - BAR_LABEL_W), rect.h};
+    }
+    if (bar.w <= 0 || bar.h <= 0) {
+        return;
+    }
+    const auto radius = static_cast<int16_t>(std::min<int>(obj["radius"] | 0, std::min(bar.w, bar.h) / 2));
+    // Rounded shapes leave their corners untouched: repaint the ends in case the bar moved (label toggled) or
+    // a square segment covered them
+    if (radius > 0) {
+        if (vertical) {
+            fillPart(bar.x, bar.y, bar.w, radius, widget.bg);
+            fillPart(bar.x, bar.y + bar.h - radius, bar.w, radius, widget.bg);
+        } else {
+            fillPart(bar.x, bar.y, radius, bar.h, widget.bg);
+            fillPart(bar.x + bar.w - radius, bar.y, radius, bar.h, widget.bg);
+        }
+    }
+    paintBar(bar, radius, vertical, segments, obj["max"] | DEFAULT_MAX, colorOr(obj["track"], DEFAULT_TRACK),
+             widget.bg);
+}
+
+auto drawBars(const Widget& widget) -> void {
+    const JsonObjectConst obj = widget.obj;
+    const Rect& rect = widget.rect;
+    const bool vertical = std::strcmp(obj["dir"] | "v", "v") == 0;
+    const auto gap = static_cast<int16_t>(obj["gap"] | DEFAULT_BARS_GAP);
+    const float max = obj["max"] | DEFAULT_MAX;
+    const uint16_t track = colorOr(obj["track"], DEFAULT_TRACK);
+    const auto list = obj["v"].as<JsonArrayConst>();
+    const size_t count = list.isNull() ? 0 : list.size();
+    const auto extent = static_cast<int16_t>(vertical ? rect.w : rect.h);
+    // Background across the bars' layout axis, from `from` for `length` pixels
+    const auto fillAcross = [&](int from, int length) {
+        if (vertical) {
+            fillPart(rect.x + from, rect.y, length, rect.h, widget.bg);
+        } else {
+            fillPart(rect.x, rect.y + from, rect.w, length, widget.bg);
+        }
+    };
+    int covered = 0;
+    size_t index = 0;
+    Segments segments;
+    for (const JsonVariantConst item : list) {
+        const Span slot = barSlot(extent, gap, count, index++);
+        if (slot.length == 0) {
+            break;
+        }
+        fillAcross(covered, slot.start - covered);
+        const Rect bar = vertical ? Rect{static_cast<int16_t>(rect.x + slot.start), rect.y, slot.length, rect.h}
+                                  : Rect{rect.x, static_cast<int16_t>(rect.y + slot.start), rect.w, slot.length};
+        readSegments(item, widget.color, segments);
+        paintBar(bar, 0, vertical, segments, max, track, widget.bg);
+        covered = slot.start + slot.length;
+        if (index % YIELD_EVERY == 0) {
+            yield();
+        }
+    }
+    fillAcross(covered, extent - covered);
+}
+
+auto drawRing(const Widget& widget) -> void {
+    const JsonObjectConst obj = widget.obj;
+    const RingGeometry ring = ringGeometry(widget.rect);
+    const int inner = ring.radius - ring.thickness;
+    const auto font = static_cast<uint8_t>(obj["f"] | RING_DEFAULT_FONT);
+    Segments segments;
+    readSegments(obj["v"], widget.color, segments);
+
+    // The number band is the same for every font (a font change leaves nothing behind) and stays within the
+    // outer radius, so the arcs drawn afterwards repaint every pixel of it that lies in the ring: the arc never
+    // blanks, only the number is repainted
+    const int maxHalf = static_cast<int>(std::sqrt(static_cast<float>(ring.radius * ring.radius - inner * inner))) - 1;
+    const int half = std::min(RING_NUMBER_HALF, maxHalf);
+    if (inner < half || inner <= 1) {
+        fillPart(widget.rect.x, widget.rect.y, widget.rect.w, widget.rect.h, widget.bg);  // tiny ring
+    }
+    TextBuffer number{};
+    if (std::strcmp(obj["show"] | "value", "none") != 0) {
+        if (segments.isNull) {
+            std::strncpy(number.data(), "--", number.size() - 1);
+        } else {
+            formatNumber(total(segments), 0, number.data(), number.size());
+        }
+    }
+    const Rect numberRect{static_cast<int16_t>(ring.cx - inner + 1), static_cast<int16_t>(ring.cy - half),
+                          static_cast<int16_t>(2 * inner - 1), static_cast<int16_t>(2 * half + 1)};
+    drawTextIn(numberRect, number.data(), font, colorOr(obj["tc"], DEFAULT_FG), widget.bg, 'c');
+    const Rect labelRect = intersect(
+        Rect{widget.rect.x, static_cast<int16_t>(ring.labelY - RING_LABEL_H / 2), widget.rect.w, RING_LABEL_H},
+        widget.rect);
+    drawTextIn(labelRect, obj["label"] | "", 0, colorOr(obj["lc"], DEFAULT_LABEL), widget.bg, 'c');
+
+    const float max = obj["max"] | DEFAULT_MAX;
+    int position = ARC_START;
+    float sum = 0;
+    for (size_t i = 0; i < segments.count; ++i) {
+        sum += segments.items[i].value;
+        const int end = ARC_START + scaleLength(sum, max, ARC_SWEEP);
+        if (end > position) {
+            tft->drawArc(ring.cx, ring.cy, ring.radius, inner, position, end, segments.items[i].color, widget.bg,
+                         true);
+            position = end;
+        }
+    }
+    if (position < ARC_START + ARC_SWEEP) {
+        tft->drawArc(ring.cx, ring.cy, ring.radius, inner, position, ARC_START + ARC_SWEEP,
+                     colorOr(obj["track"], DEFAULT_TRACK), widget.bg, true);
+    }
+}
+
+// Per-row colours of a gradient sparkline: the line colour of the value each row represents, and that colour
+// over the background at `fillPercent` (background only when 0)
+auto fillRowColors(const Gradient& gradient, int fillPercent, float minValue, float maxValue, const Widget& widget,
+                   uint16_t* lineColors, uint16_t* fillColors) -> void {
+    const Rect& rect = widget.rect;
+    const auto alpha = static_cast<uint8_t>((fillPercent * UINT8_MAX + MAX_PERCENT / 2) / MAX_PERCENT);
+    for (int row = 0; row < rect.h; ++row) {
+        const uint16_t color = gradientColor(gradient, sparkRowValue(rect.y + row, minValue, maxValue, rect));
+        lineColors[row] = color;
+        fillColors[row] = fillPercent > 0 ? tft->alphaBlend(alpha, color, widget.bg) : widget.bg;
+    }
+}
+
+// One column: background above the line, line rows [top, bottom], fill below
+auto composeColumn(uint16_t* column, int height, int top, int bottom, const uint16_t* lineColors,
+                   const uint16_t* fillColors, uint16_t background) -> void {
+    for (int row = 0; row < height; ++row) {
+        column[row] = row < top ? background : (row <= bottom ? lineColors[row] : fillColors[row]);
+    }
+}
+
+// Each sample's y relative to the rect, in 1/16 px
+auto sampleOffsets(JsonArrayConst samples, float minValue, float maxValue, const Rect& rect, uint16_t* out) -> void {
+    size_t index = 0;
+    for (const JsonVariantConst sample : samples) {
+        const float offset = sparkY(sample.as<float>(), minValue, maxValue, rect) - static_cast<float>(rect.y);
+        out[index++] = static_cast<uint16_t>(std::lround(offset * SUBPIXELS));
+    }
+}
+
+// Line y (relative to the rect) at a column, interpolated between the samples around it
+auto columnOffset(const uint16_t* sampleY, size_t count, int columnIndex, int width) -> float {
+    if (count < 2 || width < 2) {
+        return static_cast<float>(sampleY[0]) / SUBPIXELS;
+    }
+    const float position =
+        static_cast<float>(columnIndex) * static_cast<float>(count - 1) / static_cast<float>(width - 1);
+    const size_t left = std::min(static_cast<size_t>(position), count - 2);
+    const float fraction = position - static_cast<float>(left);
+    return (static_cast<float>(sampleY[left]) +
+            fraction * (static_cast<float>(sampleY[left + 1]) - static_cast<float>(sampleY[left]))) /
+           SUBPIXELS;
+}
+
+// Rows [top, bottom] of the line at a column: it spans halfway to its neighbours so consecutive columns
+// connect, and is at least 2 px thick
+auto lineRows(const uint16_t* sampleY, size_t count, int columnIndex, const Rect& rect, int& top, int& bottom)
+    -> void {
+    const float here = columnOffset(sampleY, count, columnIndex, rect.w);
+    const float before = columnIndex > 0 ? (here + columnOffset(sampleY, count, columnIndex - 1, rect.w)) / 2 : here;
+    const float after =
+        columnIndex + 1 < rect.w ? (here + columnOffset(sampleY, count, columnIndex + 1, rect.w)) / 2 : here;
+    top = static_cast<int>(std::lround(std::min({here, before, after})));
+    bottom = static_cast<int>(std::lround(std::max({here, before, after})));
+    if (bottom - top < 1) {
+        bottom = top + 1;
+    }
+    bottom = std::min(bottom, rect.h - 1);
+    top = std::max(0, std::min(top, bottom - 1));
+}
+
+// Height gradient: each row has one line colour and one fill colour (row colour over the background at `fa`
+// percent), so both are looked up from per-row tables built once per draw. Each column is then composed in a
+// buffer (background, 2 px line, fill) and pushed as one window. Returns false if the scratch memory is not
+// available; the caller then draws the plain sparkline.
+auto drawGradientSpark(const Widget& widget, JsonArrayConst samples, float minValue, float maxValue) -> bool {
+    const Rect& rect = widget.rect;
+    const size_t count = samples.size();
+    Gradient gradient;
+    readGradient(widget.obj["grad"], gradient);
+    const int fillPercent = widget.obj["fa"] | DEFAULT_GRADIENT_FILL_PERCENT;
+    const auto height = static_cast<size_t>(rect.h);
+    // Line LUT, fill LUT and column buffer (rect.h entries each), then the samples' y in 1/16 px
+    const size_t words = 3 * height + count;
+    auto* scratch = static_cast<uint16_t*>(std::malloc(words * sizeof(uint16_t)));
+    if (scratch == nullptr) {
+        return false;
+    }
+    uint16_t* lineColors = scratch;
+    uint16_t* fillColors = scratch + height;
+    uint16_t* column = scratch + 2 * height;
+    uint16_t* sampleY = scratch + 3 * height;
+    fillRowColors(gradient, fillPercent, minValue, maxValue, widget, lineColors, fillColors);
+    sampleOffsets(samples, minValue, maxValue, rect, sampleY);
+    tft->setSwapBytes(true);  // buffers hold native-endian RGB565
+    for (int columnIndex = 0; columnIndex < rect.w; ++columnIndex) {
+        int top = 0;
+        int bottom = 0;
+        lineRows(sampleY, count, columnIndex, rect, top, bottom);
+        composeColumn(column, rect.h, top, bottom, lineColors, fillColors, widget.bg);
+        tft->pushImage(rect.x + columnIndex, rect.y, 1, rect.h, column);
+        if (columnIndex % SPARK_YIELD_COLUMNS == 0) {
+            yield();
+        }
+    }
+    tft->setSwapBytes(false);
+    std::free(scratch);
+    return true;
+}
+
+// Two series: `u` as a solid area in `uc`, then the main series over it (line in `c`, area below it in `fill`
+// if given), so the main series hides `u` wherever it is as high. Composed per column like the gradient
+// sparkline, so nothing flickers. Returns false if the scratch memory is not available.
+auto drawLayeredSpark(const Widget& widget, JsonArrayConst samples, JsonArrayConst under, float minValue,
+                      float maxValue) -> bool {
+    const JsonObjectConst obj = widget.obj;
+    const Rect& rect = widget.rect;
+    const size_t count = samples.isNull() ? 0 : samples.size();
+    const size_t underCount = under.size();
+    const auto height = static_cast<size_t>(rect.h);
+    // Column buffer, then both series' y in 1/16 px
+    auto* scratch = static_cast<uint16_t*>(std::malloc((height + count + underCount) * sizeof(uint16_t)));
+    if (scratch == nullptr) {
+        return false;
+    }
+    uint16_t* column = scratch;
+    uint16_t* sampleY = scratch + height;
+    uint16_t* underY = sampleY + count;
+    sampleOffsets(samples, minValue, maxValue, rect, sampleY);
+    sampleOffsets(under, minValue, maxValue, rect, underY);
+    const uint16_t underColor = colorOr(obj["uc"], DEFAULT_FG);
+    const bool hasFill = !obj["fill"].isNull();
+    const uint16_t fill = colorOr(obj["fill"], widget.bg);
+    tft->setSwapBytes(true);  // buffers hold native-endian RGB565
+    for (int columnIndex = 0; columnIndex < rect.w; ++columnIndex) {
+        int top = rect.h;  // no main series: no line
+        int bottom = rect.h;
+        if (count > 0) {
+            lineRows(sampleY, count, columnIndex, rect, top, bottom);
+        }
+        const auto underTop = static_cast<int>(std::lround(columnOffset(underY, underCount, columnIndex, rect.w)));
+        for (int row = 0; row < rect.h; ++row) {
+            uint16_t color = row >= underTop ? underColor : widget.bg;
+            if (row >= top && row <= bottom) {
+                color = widget.color;
+            } else if (row > bottom && hasFill) {
+                color = fill;
+            }
+            column[row] = color;
+        }
+        tft->pushImage(rect.x + columnIndex, rect.y, 1, rect.h, column);
+        if (columnIndex % SPARK_YIELD_COLUMNS == 0) {
+            yield();
+        }
+    }
+    tft->setSwapBytes(false);
+    std::free(scratch);
+    return true;
+}
+
+auto drawSpark(const Widget& widget) -> void {
+    const JsonObjectConst obj = widget.obj;
+    const Rect& rect = widget.rect;
+    const auto samples = obj["v"].as<JsonArrayConst>();
+    const auto under = obj["u"].as<JsonArrayConst>();
+    const size_t count = samples.isNull() ? 0 : samples.size();
+    const size_t underCount = under.isNull() ? 0 : under.size();
+    if (count == 0 && underCount == 0) {
+        fillPart(rect.x, rect.y, rect.w, rect.h, widget.bg);
+        return;
+    }
+    const float minValue = obj["min"] | 0.0F;
+    float maxValue = 0;
+    if (obj["max"].is<float>()) {
+        maxValue = obj["max"].as<float>();
+    } else {  // no max: scale to the largest sample of either series
+        maxValue = minValue;
+        for (const JsonVariantConst sample : samples) {
+            maxValue = std::max(maxValue, sample.as<float>());
+        }
+        for (const JsonVariantConst sample : under) {
+            maxValue = std::max(maxValue, sample.as<float>());
+        }
+    }
+    if (!(maxValue > minValue)) {
+        maxValue = minValue + 1;
+    }
+    if (underCount > 0 && drawLayeredSpark(widget, samples, under, minValue, maxValue)) {
+        return;
+    }
+    if (count == 0) {  // only `u`, and no memory to draw it
+        fillPart(rect.x, rect.y, rect.w, rect.h, widget.bg);
+        return;
+    }
+    if (!obj["grad"].isNull() && drawGradientSpark(widget, samples, minValue, maxValue)) {
+        return;
+    }
+    const bool hasFill = !obj["fill"].isNull();
+    const uint16_t fill = colorOr(obj["fill"], widget.bg);
+    const int bottom = rect.y + rect.h - 1;
+    const int right = rect.x + rect.w - 1;
+    // Every column is repainted top to bottom (background above the line, fill below it): no blank frame
+    const auto paintColumn = [&](int column, float lineY) {
+        const auto level = static_cast<int>(std::lround(lineY));
+        fillPart(column, rect.y, 1, level - rect.y, widget.bg);
+        fillPart(column, level, 1, bottom - level + 1, hasFill ? fill : widget.bg);
+    };
+    float previousX = 0;
+    float previousY = 0;
+    int nextColumn = rect.x;
+    size_t index = 0;
+    for (const JsonVariantConst sample : samples) {
+        const float pointX = sparkX(index, count, rect);
+        const float pointY = sparkY(sample.as<float>(), minValue, maxValue, rect);
+        const int lastColumn = std::min(right, static_cast<int>(std::floor(pointX)));
+        for (; nextColumn <= lastColumn; ++nextColumn) {
+            const float span = pointX - previousX;
+            const float fraction = (index == 0 || span <= 0) ? 1.0F : (static_cast<float>(nextColumn) - previousX) / span;
+            paintColumn(nextColumn, previousY + fraction * (pointY - previousY));
+        }
+        previousX = pointX;
+        previousY = pointY;
+        ++index;
+    }
+    for (; nextColumn <= right; ++nextColumn) {
+        paintColumn(nextColumn, previousY);
+    }
+    yield();
+    index = 0;
+    for (const JsonVariantConst sample : samples) {
+        const float pointX = sparkX(index, count, rect);
+        const float pointY = sparkY(sample.as<float>(), minValue, maxValue, rect);
+        if (index > 0) {
+            tft->drawWideLine(previousX, previousY, pointX, pointY, SPARK_LINE_W, widget.color, widget.bg);
+        } else if (count == 1) {
+            tft->drawWideLine(pointX, pointY, static_cast<float>(right), pointY, SPARK_LINE_W, widget.color, widget.bg);
+        }
+        previousX = pointX;
+        previousY = pointY;
+        ++index;
+    }
+}
+
+// PC icon: centred, unscaled, each pixel blended over the background; pushed one row at a time
+auto drawBitmapIcon(const Widget& widget, const uint8_t* body, const IconHeader& header) -> void {
+    const Rect& rect = widget.rect;
+    const int left = rect.x + (rect.w - header.width) / 2;
+    const int top = rect.y + (rect.h - header.height) / 2;
+    std::array<uint16_t, MAX_ICON_SIDE> line{};
+    tft->setSwapBytes(true);  // the line buffer holds native-endian RGB565
+    for (uint8_t row = 0; row < header.height; ++row) {
+        for (uint8_t column = 0; column < header.width; ++column) {
+            uint16_t color = widget.color;
+            const uint8_t alpha = iconPixel(body, header, column, row, widget.color, color);
+            line[column] = alpha == 0 ? widget.bg : tft->alphaBlend(alpha, color, widget.bg);
+        }
+        tft->pushImage(left, top + row, header.width, 1, line.data());
+    }
+    tft->setSwapBytes(false);
+}
+
+// NOLINTBEGIN(readability-magic-numbers): proportions of the built-in icons
+auto drawBuiltinIcon(const Widget& widget, const char* name) -> void {
+    const Rect& rect = widget.rect;
+    const int size = std::min(rect.w, rect.h);
+    const int centerX = rect.x + rect.w / 2;
+    const int centerY = rect.y + rect.h / 2;
+    const auto side = static_cast<float>(size);
+    const float left = static_cast<float>(centerX) - side / 2.0F;
+    const float top = static_cast<float>(centerY) - side / 2.0F;
+    if (std::strcmp(name, "dot") == 0) {
+        tft->fillSmoothCircle(centerX, centerY, (size - 1) / 2, widget.color, widget.bg);
+    } else if (std::strcmp(name, "warn") == 0) {
+        const int half = size / 2;
+        tft->fillTriangle(centerX, centerY - half, centerX - half, centerY + half - 1, centerX + half - 1,
+                          centerY + half - 1, widget.color);
+        const int stroke = std::max(2, size / 8);
+        fillPart(centerX - stroke / 2, centerY - size / 6, stroke, size / 3, widget.bg);
+        fillPart(centerX - stroke / 2, centerY + size / 4 - stroke / 2, stroke, stroke, widget.bg);
+    } else if (std::strcmp(name, "check") == 0) {
+        const float stroke = std::max(2.0F, side / 8.0F);
+        tft->drawWideLine(left + 0.18F * side, top + 0.52F * side, left + 0.42F * side, top + 0.76F * side, stroke,
+                          widget.color, widget.bg);
+        tft->drawWideLine(left + 0.42F * side, top + 0.76F * side, left + 0.84F * side, top + 0.26F * side, stroke,
+                          widget.color, widget.bg);
+    }
+}
+// NOLINTEND(readability-magic-numbers)
+
+// Returns false while a PC icon is not cached yet (the rect stays cleared and the icon is requested)
+auto drawIcon(const Widget& widget) -> bool {
+    const char* name = widget.obj["v"] | "";
+    if (name[0] == '\0') {
+        return true;
+    }
+    if (isBuiltinIcon(name)) {
+        drawBuiltinIcon(widget, name);
+        return true;
+    }
+    const uint32_t hash = widget.obj["h"] | 0U;
+    const uint8_t* body = nullptr;
+    IconHeader header;
+    if (!IconCache::find(name, hash, body, header)) {
+        IconCache::request(name, hash);
+        return false;
+    }
+    drawBitmapIcon(widget, body, header);
+    return true;
+}
+
+auto drawPanel(const Widget& widget) -> void {
+    const Rect& rect = widget.rect;
+    const int radius = widget.obj["radius"] | DEFAULT_PANEL_RADIUS;
+    tft->fillSmoothRoundRect(rect.x, rect.y, rect.w, rect.h, radius, widget.color, widget.bg);
+}
+
+// Types that repaint every pixel of their rect themselves, so updates need no blanking first
+auto paintsWholeRect(WidgetType type) -> bool { return type != WidgetType::Icon && type != WidgetType::Panel; }
+
+// The SmallTV panel stores pixels in BGR order (verified on the device: pure red and blue appeared swapped
+// with MADCTL 0x00). Arduino_GFX, which owns the orientation, always writes MADCTL with the RGB bit, so after
+// each of its setRotation() calls the same orientation is re-sent with the BGR bit set.
+constexpr uint8_t MADCTL_COMMAND = 0x36;
+constexpr uint8_t MADCTL_BGR = 0x08;
+// Arduino_ST7789::setRotation()'s orientation bits (MY 0x80, MX 0x40, MV 0x20) for rotations 0..7
+constexpr std::array<uint8_t, 8> ARDUINO_GFX_MADCTL = {0x00, 0x60, 0xC0, 0xA0, 0x40, 0xE0, 0x80, 0x20};
+
+auto setRotationBgr() -> void {
+    Arduino_GFX* gfx = DisplayManager::getGfx();
+    const uint8_t rotation = gfx->getRotation();
+    gfx->setRotation(rotation);  // also makes Arduino_GFX forget its cached address window
+    tft->writecommand(MADCTL_COMMAND);
+    tft->writedata(ARDUINO_GFX_MADCTL[rotation % ARDUINO_GFX_MADCTL.size()] | MADCTL_BGR);
+}
+
+}  // namespace
+
+auto WidgetPainter::begin() -> bool {
+    if (tft != nullptr) {
+        return true;
+    }
+    tft = new TFT_eSPI();  // NOLINT(cppcoreguidelines-owning-memory): lives for the firmware's lifetime
+    tft->init();
+    // TFT_eSPI's init resets the panel to its rotation 0. Keep the configured orientation, which Arduino_GFX
+    // applies (it also supports the mirrored rotations 4..7). The panel is square without RAM offsets, so
+    // TFT_eSPI's coordinates stay valid under any MADCTL.
+    setRotationBgr();
+    Logger::info("TFT_eSPI initialised", "WidgetPainter");
+    return true;
+}
+
+auto WidgetPainter::beginPass() -> void {
+    // setAddrWindow resets TFT_eSPI's cached address window (Arduino_GFX may have moved it)
+    tft->setAddrWindow(0, 0, 1, 1);
+    currentClip = Rect{0, 0, SCREEN_W, SCREEN_H};
+    tft->resetViewport();
+}
+
+auto WidgetPainter::endPass() -> void {
+    releaseFont();
+    tft->resetViewport();
+    // Rewrites MADCTL (orientation + BGR) and makes Arduino_GFX forget its cached address window
+    setRotationBgr();
+}
+
+auto WidgetPainter::fillScreen(uint16_t color) -> void { tft->fillScreen(color); }
+
+auto WidgetPainter::fillRect(const Rect& rect, uint16_t color) -> void {
+    fillPart(rect.x, rect.y, rect.w, rect.h, color);
+}
+
+auto WidgetPainter::drawWidget(JsonObjectConst widget, uint16_t screenBg, bool clearFirst) -> bool {
+    Widget context;
+    WidgetType type = WidgetType::Text;
+    if (!readRect(widget["r"], context.rect) || !parseType(widget["t"].as<const char*>(), type)) {
+        return true;
+    }
+    context.obj = widget;
+    context.bg = colorOr(widget["bg"], screenBg);
+    context.color = colorOr(widget["c"], DEFAULT_FG);
+    context.font = static_cast<uint8_t>(widget["f"] | 0);
+    const ClipScope clip(context.rect);
+    if (clearFirst || !paintsWholeRect(type)) {
+        fillPart(context.rect.x, context.rect.y, context.rect.w, context.rect.h, context.bg);
+    }
+    switch (type) {
+        case WidgetType::Text:
+            drawText(context);
+            break;
+        case WidgetType::Value:
+            drawValue(context);
+            break;
+        case WidgetType::Bar:
+            drawBar(context);
+            break;
+        case WidgetType::Bars:
+            drawBars(context);
+            break;
+        case WidgetType::Ring:
+            drawRing(context);
+            break;
+        case WidgetType::Spark:
+            drawSpark(context);
+            break;
+        case WidgetType::Icon:
+            return drawIcon(context);
+        case WidgetType::Panel:
+            drawPanel(context);
+            break;
+    }
+    return true;
+}
+
+auto WidgetPainter::drawOfflineDot(uint16_t screenBg) -> void {
+    // NOLINTBEGIN(readability-magic-numbers): dot centred in OFFLINE_DOT_RECT
+    fillPart(OFFLINE_DOT_RECT.x, OFFLINE_DOT_RECT.y, OFFLINE_DOT_RECT.w, OFFLINE_DOT_RECT.h, screenBg);
+    tft->fillSmoothCircle(OFFLINE_DOT_RECT.x + 6, OFFLINE_DOT_RECT.y + 6, 4, OFFLINE_RED, screenBg);
+    // NOLINTEND(readability-magic-numbers)
+}
+
+auto WidgetPainter::drawWaiting(const char* address, const char* url) -> void {
+    // NOLINTBEGIN(readability-magic-numbers): fixed layout of the boot screen
+    tft->fillScreen(DEFAULT_BG);
+    drawTextIn(Rect{0, 92, SCREEN_W, 24}, "Waiting for PC", 0, DEFAULT_FG, DEFAULT_BG, 'c');
+    drawTextIn(Rect{0, 120, SCREEN_W, 20}, address, 0, DEFAULT_LABEL, DEFAULT_BG, 'c');
+    drawTextIn(Rect{0, 142, SCREEN_W, 20}, url, 0, DEFAULT_LABEL, DEFAULT_BG, 'c');
+    // NOLINTEND(readability-magic-numbers)
+}
+
+// NOLINTEND(readability-misplaced-array-index)
+}  // namespace renderer
+#endif
