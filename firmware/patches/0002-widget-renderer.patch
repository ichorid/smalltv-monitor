+    EXPECT(codeOf(one(spark + "]}")) == ErrorCode::Value);
+    EXPECT(codeOf(one(R"({"id":"a","t":"spark","r":[0,0,100,10],"v":[1,"x"]})")) == ErrorCode::Value);
+    EXPECT(codeOf(one(R"({"id":"a","t":"spark","r":[0,0,100,10],"min":10,"max":5,"v":[1]})")) == ErrorCode::Field);
+    EXPECT(codeOf(one(R"({"id":"a","t":"value","r":[0,0,100,10],"v":["n/a","#ff0000"],"dp":2})")) ==
