+void testGradient() {
+    const auto spark = [](const std::string& extra) {
+        return one(R"({"id":"s","t":"spark","r":[0,0,100,20],"max":100,"v":[1,50,99])" + extra + "}");
+    };
+    EXPECT(codeOf(spark(R"(,"grad":[[0,"#3b82f6"],[50,"#facc15"],[100,"#ef4444"]],"fa":35)")) == ErrorCode::None);
+    EXPECT(codeOf(spark(R"(,"grad":[[0,"#3b82f6"]])")) == ErrorCode::Value);  // one stop
+    EXPECT(codeOf(spark(R"(,"grad":[[0,"#000000"],[1,"#000000"],[2,"#000000"],[3,"#000000"],[4,"#000000"],)"
+                        R"([5,"#000000"],[6,"#000000"],[7,"#000000"],[8,"#000000"]])")) == ErrorCode::Value);  // 9
+    EXPECT(codeOf(spark(R"(,"grad":[[50,"#000000"],[10,"#ffffff"]])")) == ErrorCode::Value);  // descending
+    EXPECT(codeOf(spark(R"(,"grad":[[10,"#000000"],[10,"#ffffff"]])")) == ErrorCode::Value);  // equal
+    EXPECT(codeOf(spark(R"(,"grad":[[0,"#000000"],[10,"#fff"]])")) == ErrorCode::Color);
+    EXPECT(codeOf(spark(R"(,"grad":[[0,"#000000"],["x","#ffffff"]])")) == ErrorCode::Value);
+    EXPECT(codeOf(spark(R"(,"grad":"#ffffff")")) == ErrorCode::Value);
+    EXPECT(codeOf(spark(R"(,"fa":101)")) == ErrorCode::Field);
+    EXPECT(codeOf(spark(R"(,"fa":0)")) == ErrorCode::None);
+
+    JsonDocument doc;
+    deserializeJson(doc, R"([[0,"#000000"],[10,"#ff0000"],[20,"#00ff00"]])");
+    renderer::Gradient gradient;
+    EXPECT(renderer::readGradient(doc.as<JsonVariantConst>(), gradient) == ErrorCode::None && gradient.count == 3);
+    // Clamped at both ends
+    EXPECT(renderer::gradientColor(gradient, -5) == 0x0000);
+    EXPECT(renderer::gradientColor(gradient, 999) == 0x07E0);
+    // Exactly the stop colours at the stops
+    EXPECT(renderer::gradientColor(gradient, 0) == 0x0000);
+    EXPECT(renderer::gradientColor(gradient, 10) == 0xF800);
+    EXPECT(renderer::gradientColor(gradient, 20) == 0x07E0);
+    // Midpoints, interpolated in RGB888 then converted: 127.5 -> 128 (0x80)
+    EXPECT(renderer::gradientColor(gradient, 5) == renderer::rgb565(0x800000));
+    EXPECT(renderer::gradientColor(gradient, 15) == renderer::rgb565(0x808000));
+    EXPECT(renderer::gradientColor(gradient, 2.5F) == renderer::rgb565(0x400000));  // 63.75 -> 64
+
+    // Inverse of the y mapping: top row = max, bottom row = min, and sparkY(row value) gives the row back
+    const renderer::Rect rect{8, 186, 224, 24};
+    EXPECT(renderer::sparkRowValue(186, 0, 100, rect) == 100.0F);
+    EXPECT(renderer::sparkRowValue(209, 0, 100, rect) == 0.0F);
+    for (int row = rect.y; row < rect.y + rect.h; ++row) {
+        const float value = renderer::sparkRowValue(row, 10, 60, rect);
+        EXPECT(std::lround(renderer::sparkY(value, 10, 60, rect)) == row);
+    }
+}
