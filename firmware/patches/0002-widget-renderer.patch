+// SPDX-License-Identifier: GPL-3.0-or-later
+// Widget protocol v1 model. No Arduino dependencies: compiled by test/host/run.sh as well.
+#include "renderer/WidgetModel.h"
+
+#include <cctype>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+
+namespace renderer {
+
+namespace {
+
+constexpr uint32_t REPLACEMENT_CHAR = 0xFFFD;
+constexpr int HEX_DIGITS_PER_CHANNEL = 2;
+constexpr size_t COLOR_TEXT_LENGTH = 7;  // "#rrggbb"
+constexpr int MAX_BRIGHTNESS = 100;
+constexpr int MAX_PERCENT = 100;
+constexpr int MAX_GAP = SCREEN_W - 1;
+constexpr int MAX_RADIUS = SCREEN_W / 2;
+constexpr double FORMAT_LIMIT = 1e9;
+constexpr unsigned ASCII_END = 0x80U;
+
+struct TypeName {
+    const char* name;
+    WidgetType type;
+};
+
+constexpr std::array<TypeName, 8> TYPE_NAMES = {{
+    {"text", WidgetType::Text},
+    {"value", WidgetType::Value},
+    {"bar", WidgetType::Bar},
+    {"bars", WidgetType::Bars},
+    {"ring", WidgetType::Ring},
+    {"spark", WidgetType::Spark},
+    {"icon", WidgetType::Icon},
+    {"panel", WidgetType::Panel},
+}};
+
+auto hexValue(char chr) -> int {
+    if (chr >= '0' && chr <= '9') {
+        return chr - '0';
+    }
+    if (chr >= 'a' && chr <= 'f') {
+        return chr - 'a' + 10;  // NOLINT(readability-magic-numbers)
+    }
+    if (chr >= 'A' && chr <= 'F') {
+        return chr - 'A' + 10;  // NOLINT(readability-magic-numbers)
+    }
+    return -1;
+}
+
+auto isOneOf(const char* text, const char* first, const char* second) -> bool {
+    return text != nullptr && (std::strcmp(text, first) == 0 || std::strcmp(text, second) == 0);
+}
+
+// Optional string field: absent/null is fine, otherwise a string of at most MAX_STRING_CHARS characters
+// ArduinoJson's operator[] (obj["key"]) is misreported by readability-misplaced-array-index under `pio check`,
+// whose clang-tidy cannot find its resource headers and parses ArduinoJson in error recovery (a correct parse
+// shows CXXOperatorCallExpr). Upstream suppresses the same check on these accesses.
+// NOLINTBEGIN(readability-misplaced-array-index)
+auto checkString(JsonObjectConst obj, const char* key) -> ErrorCode {
+    const JsonVariantConst value = obj[key];
+    if (value.isNull()) {
+        return ErrorCode::None;
+    }
+    if (!value.is<const char*>()) {
+        return ErrorCode::Field;
+    }
+    return utf8Length(value.as<const char*>()) <= MAX_STRING_CHARS ? ErrorCode::None : ErrorCode::String;
+}
+
+auto checkColor(JsonObjectConst obj, const char* key) -> ErrorCode {
+    const JsonVariantConst value = obj[key];
+    if (value.isNull()) {
+        return ErrorCode::None;
+    }
+    uint16_t color = 0;
+    return value.is<const char*>() && parseColor(value.as<const char*>(), color) ? ErrorCode::None
+                                                                                 : ErrorCode::Color;
+}
+
+auto checkInt(JsonObjectConst obj, const char* key, int low, int high, ErrorCode code) -> ErrorCode {
+    const JsonVariantConst value = obj[key];
+    if (value.isNull()) {
+        return ErrorCode::None;
+    }
+    if (!value.is<int>()) {
+        return code;
+    }
+    const int number = value.as<int>();
+    return number >= low && number <= high ? ErrorCode::None : code;
+}
+
+auto checkChoice(JsonObjectConst obj, const char* key, const char* first, const char* second,
+                 const char* third = nullptr) -> ErrorCode {
+    const JsonVariantConst value = obj[key];
+    if (value.isNull()) {
+        return ErrorCode::None;
+    }
+    const char* text = value.as<const char*>();
+    if (isOneOf(text, first, second) || (third != nullptr && text != nullptr && std::strcmp(text, third) == 0)) {
+        return ErrorCode::None;
+    }
+    return ErrorCode::Field;
+}
+
+auto firstError(std::initializer_list<ErrorCode> codes) -> ErrorCode {
+    for (const ErrorCode code : codes) {
+        if (code != ErrorCode::None) {
+            return code;
+        }
+    }
+    return ErrorCode::None;
+}
+
+auto checkMax(JsonObjectConst obj) -> ErrorCode {
+    const JsonVariantConst value = obj["max"];
+    if (value.isNull()) {
+        return ErrorCode::None;
+    }
+    return value.is<float>() && value.as<float>() > 0 ? ErrorCode::None : ErrorCode::Field;
+}
+
+// A text value: string or null
+auto checkTextValue(JsonVariantConst value) -> ErrorCode {
+    if (value.isNull()) {
+        return ErrorCode::None;
+    }
+    if (!value.is<const char*>()) {
+        return ErrorCode::Value;
+    }
+    return utf8Length(value.as<const char*>()) <= MAX_STRING_CHARS ? ErrorCode::None : ErrorCode::String;
+}
+
+// `value` widget: number, string, null, or [number|string, "#colour"]
+auto checkValueValue(JsonVariantConst value) -> ErrorCode {
+    if (value.isNull() || value.is<float>()) {
+        return ErrorCode::None;
+    }
+    if (value.is<const char*>()) {
+        return checkTextValue(value);
+    }
+    const auto pair = value.as<JsonArrayConst>();
+    if (pair.isNull() || pair.size() != 2) {
+        return ErrorCode::Value;
+    }
+    uint16_t color = 0;
+    const char* colorText = pair[1].as<const char*>();
+    if (colorText == nullptr || !parseColor(colorText, color)) {
+        return ErrorCode::Color;
+    }
+    return pair[0].is<float>() ? ErrorCode::None : checkTextValue(pair[0]);
+}
+
+auto checkBarsValue(JsonVariantConst value) -> ErrorCode {
+    if (value.isNull()) {
+        return ErrorCode::None;
+    }
+    const auto bars = value.as<JsonArrayConst>();
+    if (bars.isNull() || bars.size() > MAX_BARS) {
+        return ErrorCode::Value;
+    }
+    Segments segments;
+    for (const JsonVariantConst bar : bars) {
+        if (!readSegments(bar, 0, segments)) {
+            return ErrorCode::Value;
+        }
+    }
+    return ErrorCode::None;
+}
+
+auto checkSparkValue(JsonVariantConst value) -> ErrorCode {
+    if (value.isNull()) {
+        return ErrorCode::None;
+    }
+    const auto samples = value.as<JsonArrayConst>();
+    if (samples.isNull() || samples.size() > MAX_SPARK) {
+        return ErrorCode::Value;
+    }
+    for (const JsonVariantConst sample : samples) {
+        if (!sample.is<float>()) {
+            return ErrorCode::Value;
+        }
+    }
+    return ErrorCode::None;
+}
+
+auto checkSparkRange(JsonObjectConst obj) -> ErrorCode {
+    const JsonVariantConst minValue = obj["min"];
+    const JsonVariantConst maxValue = obj["max"];
+    if (!minValue.isNull() && !minValue.is<float>()) {
+        return ErrorCode::Field;
+    }
+    if (!maxValue.isNull() && !maxValue.is<float>()) {
+        return ErrorCode::Field;
+    }
+    const float low = minValue | 0.0F;
+    if (!maxValue.isNull() && maxValue.as<float>() <= low) {
+        return ErrorCode::Field;
+    }
+    return ErrorCode::None;
+}
+
+// `v` names a built-in icon, or a PC icon that also needs its content hash `h`
+auto checkIcon(JsonObjectConst obj) -> ErrorCode {
+    const JsonVariantConst value = obj["v"];
+    const ErrorCode code = checkTextValue(value);
+    if (code != ErrorCode::None || value.isNull()) {
+        return code;
+    }
+    const JsonVariantConst hash = obj["h"];
+    if (hash.isNull()) {
+        return isBuiltinIcon(value.as<const char*>()) ? ErrorCode::None : ErrorCode::Field;
+    }
+    return hash.is<uint32_t>() ? ErrorCode::None : ErrorCode::Field;
+}
+
+auto checkTypeFields(JsonObjectConst obj, WidgetType type) -> ErrorCode {
+    const JsonVariantConst value = obj["v"];
+    Segments segments;
+    switch (type) {
+        case WidgetType::Text:
+            return firstError({checkChoice(obj, "a", "l", "c", "r"), checkString(obj, "text"), checkTextValue(value)});
+        case WidgetType::Value:
+            return firstError({checkChoice(obj, "a", "l", "c", "r"), checkString(obj, "unit"), checkString(obj, "label"),
+                               checkInt(obj, "dp", 0, MAX_DECIMALS, ErrorCode::Field), checkValueValue(value)});
+        case WidgetType::Bar:
+            return firstError({checkChoice(obj, "dir", "h", "v"), checkMax(obj), checkColor(obj, "track"),
+                               checkString(obj, "label"), checkInt(obj, "radius", 0, MAX_RADIUS, ErrorCode::Field),
+                               readSegments(value, 0, segments) ? ErrorCode::None : ErrorCode::Value});
+        case WidgetType::Ring:
+            return firstError({checkChoice(obj, "show", "value", "none"), checkMax(obj), checkColor(obj, "track"),
+                               checkString(obj, "label"),
+                               readSegments(value, 0, segments) ? ErrorCode::None : ErrorCode::Value});
+        case WidgetType::Bars:
+            return firstError({checkChoice(obj, "dir", "h", "v"), checkMax(obj), checkColor(obj, "track"),
+                               checkInt(obj, "gap", 0, MAX_GAP, ErrorCode::Field), checkBarsValue(value)});
+        case WidgetType::Spark: {
+            Gradient gradient;
+            // `u` (a second series drawn underneath) is not combined with the height gradient
+            const ErrorCode layered = !obj["u"].isNull() && !obj["grad"].isNull() ? ErrorCode::Field : ErrorCode::None;
+            return firstError({checkSparkRange(obj), checkColor(obj, "fill"), checkSparkValue(value),
+                               checkSparkValue(obj["u"]), checkColor(obj, "uc"), layered,
+                               readGradient(obj["grad"], gradient),
+                               checkInt(obj, "fa", 0, MAX_PERCENT, ErrorCode::Field)});
+        }
+        case WidgetType::Icon:
+            return checkIcon(obj);
+        case WidgetType::Panel:
+            return checkInt(obj, "radius", 0, MAX_RADIUS, ErrorCode::Field);
+    }
+    return ErrorCode::Type;
+}
+
+auto checkCommonFields(JsonObjectConst obj) -> ErrorCode {
+    return firstError({checkInt(obj, "f", 0, FONT_COUNT - 1, ErrorCode::Font), checkColor(obj, "c"),
+                       checkColor(obj, "bg"), checkColor(obj, "tc"), checkColor(obj, "lc")});
+}
+
+// Geometry key of a widget: its rect plus its own background. In-place repaints rely on both staying the same,
+// so a change of either makes the frame a layout change (full redraw).
+auto geometryHash(const Rect& rect, JsonVariantConst background) -> uint32_t {
+    HashWriter writer;
+    for (const int16_t part : {rect.x, rect.y, rect.w, rect.h}) {
+        const auto bits = static_cast<uint16_t>(part);
+        writer.write(static_cast<uint8_t>(bits & 0xFFU));  // NOLINT(readability-magic-numbers)
+        writer.write(static_cast<uint8_t>(bits >> 8U));    // NOLINT(readability-magic-numbers)
+    }
+    const char* bgText = background.as<const char*>();
+    for (const char* cursor = bgText != nullptr ? bgText : ""; *cursor != '\0'; ++cursor) {
+        writer.write(static_cast<uint8_t>(*cursor));
+    }
+    return writer.hash();
+}
+
+auto validateScreen(JsonVariantConst value, ScreenConfig& screen) -> ErrorCode {
+    screen = ScreenConfig{};
+    if (value.isNull()) {
+        return ErrorCode::None;
+    }
+    const auto obj = value.as<JsonObjectConst>();
+    if (obj.isNull()) {
+        return ErrorCode::Screen;
+    }
+    const ErrorCode code = firstError({
+        checkColor(obj, "bg"),
+        checkInt(obj, "bri", 0, MAX_BRIGHTNESS, ErrorCode::Screen),
+        checkInt(obj, "offline_bri", 0, MAX_BRIGHTNESS, ErrorCode::Screen),
+        checkInt(obj, "poll_ms", 1, INT32_MAX, ErrorCode::Screen),
+        checkInt(obj, "offline_dim_s", 0, INT32_MAX, ErrorCode::Screen),
+    });
+    if (code != ErrorCode::None) {
+        return code == ErrorCode::Color ? ErrorCode::Screen : code;
+    }
+    screen.bg = colorOr(obj["bg"], DEFAULT_BG);
+    screen.bri = obj["bri"] | DEFAULT_BRI;
+    screen.offlineBri = obj["offline_bri"] | DEFAULT_OFFLINE_BRI;
+    const uint32_t pollMs = obj["poll_ms"] | DEFAULT_POLL_MS;
+    screen.pollMs = pollMs < MIN_POLL_MS ? MIN_POLL_MS : (pollMs > MAX_POLL_MS ? MAX_POLL_MS : pollMs);
+    screen.offlineDimS = obj["offline_dim_s"] | DEFAULT_OFFLINE_DIM_S;
+    return ErrorCode::None;
+}
+
+// Checks one widget and fills its slot; ids of earlier widgets are needed for the duplicate check
+auto validateWidget(JsonObjectConst obj, JsonArrayConst widgets, size_t index, Rect& rect, WidgetSlot& slot)
+    -> ErrorCode {
+    const char* widgetId = obj["id"].as<const char*>();
+    if (widgetId == nullptr || widgetId[0] == '\0' || utf8Length(widgetId) > MAX_STRING_CHARS) {
+        return ErrorCode::Id;
+    }
+    for (size_t other = 0; other < index; ++other) {
+        const char* otherId = widgets[other]["id"].as<const char*>();
+        if (otherId != nullptr && std::strcmp(otherId, widgetId) == 0) {
+            return ErrorCode::Id;
+        }
+    }
+    WidgetType type = WidgetType::Text;
+    if (!parseType(obj["t"].as<const char*>(), type)) {
+        return ErrorCode::Type;
+    }
+    if (!readRect(obj["r"], rect)) {
+        return ErrorCode::Rect;
+    }
+    const ErrorCode code = firstError({checkCommonFields(obj), checkTypeFields(obj, type)});
+    if (code != ErrorCode::None) {
+        return code;
+    }
+    HashWriter content;
+    serializeJson(obj, content);
+    slot.idHash = fnv1a(widgetId);
+    slot.rectHash = geometryHash(rect, obj["bg"]);
+    slot.contentHash = content.hash();
+    return ErrorCode::None;
+}
+
+auto findSlot(const Frame& frame, uint32_t idHash) -> const WidgetSlot* {
+    for (size_t i = 0; i < frame.count; ++i) {
+        if (frame.slots[i].idHash == idHash) {
+            return &frame.slots[i];
+        }
+    }
+    return nullptr;
+}
+
+}  // namespace
+
+auto total(const Segments& segments) -> float {
+    float sum = 0;
+    for (size_t i = 0; i < segments.count; ++i) {
+        sum += segments.items[i].value;
+    }
+    return sum;
+}
+
+auto fnv1a(const char* text) -> uint32_t {
+    HashWriter writer;
+    for (const char* cursor = text; *cursor != '\0'; ++cursor) {
+        writer.write(static_cast<uint8_t>(*cursor));
+    }
+    return writer.hash();
+}
+
+auto parseColor888(const char* text, uint32_t& out) -> bool {
+    if (text == nullptr || std::strlen(text) != COLOR_TEXT_LENGTH || text[0] != '#') {
+        return false;
+    }
+    uint32_t rgb = 0;
+    for (size_t digit = 1; digit < COLOR_TEXT_LENGTH; ++digit) {
+        const int nibble = hexValue(text[digit]);
+        if (nibble < 0) {
+            return false;
+        }
+        rgb = (rgb << 4U) | static_cast<uint32_t>(nibble);  // NOLINT(readability-magic-numbers)
+    }
+    out = rgb;
+    return true;
+}
+
+// NOLINTBEGIN(readability-magic-numbers): RGB888 -> RGB565 bit layout
+auto rgb565(uint32_t rgb) -> uint16_t {
+    const uint32_t red = (rgb >> 16U) & 0xFFU;
+    const uint32_t green = (rgb >> 8U) & 0xFFU;
+    const uint32_t blue = rgb & 0xFFU;
+    return static_cast<uint16_t>(((red & 0xF8U) << 8U) | ((green & 0xFCU) << 3U) | (blue >> 3U));
+}
+// NOLINTEND(readability-magic-numbers)
+
+auto parseColor(const char* text, uint16_t& out) -> bool {
+    uint32_t rgb = 0;
+    if (!parseColor888(text, rgb)) {
+        return false;
+    }
+    out = rgb565(rgb);
+    return true;
+}
+
+auto parseType(const char* text, WidgetType& out) -> bool {
+    if (text == nullptr) {
+        return false;
+    }
+    for (const TypeName& entry : TYPE_NAMES) {
+        if (std::strcmp(entry.name, text) == 0) {
+            out = entry.type;
+            return true;
+        }
+    }
+    return false;
+}
+
+// NOLINTBEGIN(readability-magic-numbers): UTF-8 bit patterns
+auto decodeUtf8(const char*& cursor) -> uint32_t {
+    const auto lead = static_cast<uint8_t>(*cursor);
+    if (lead == 0) {
+        return 0;
+    }
+    ++cursor;
+    if (lead < 0x80U) {
+        return lead;
+    }
+    size_t extra = 0;
+    uint32_t code = 0;
+    if ((lead & 0xE0U) == 0xC0U) {
+        extra = 1;
+        code = lead & 0x1FU;
+    } else if ((lead & 0xF0U) == 0xE0U) {
+        extra = 2;
+        code = lead & 0x0FU;
+    } else if ((lead & 0xF8U) == 0xF0U) {
+        extra = 3;
+        code = lead & 0x07U;
+    } else {
+        return REPLACEMENT_CHAR;
+    }
+    for (size_t i = 0; i < extra; ++i) {
+        const auto next = static_cast<uint8_t>(*cursor);
+        if ((next & 0xC0U) != 0x80U) {
+            return REPLACEMENT_CHAR;  // truncated sequence: do not consume the next lead byte
+        }
+        code = (code << 6U) | (next & 0x3FU);
+        ++cursor;
+    }
+    return code;
+}
+// NOLINTEND(readability-magic-numbers)
+
+auto utf8Length(const char* text) -> size_t {
+    size_t length = 0;
+    const char* cursor = text;
+    while (decodeUtf8(cursor) != 0) {
+        ++length;
+    }
+    return length;
+}
+
+auto errorName(ErrorCode code) -> const char* {
+    switch (code) {
+        case ErrorCode::None:
+            return "none";
+        case ErrorCode::Http:
+            return "http";
+        case ErrorCode::Size:
+            return "size";
+        case ErrorCode::Json:
+            return "json";
+        case ErrorCode::NoMemory:
+            return "nomem";
+        case ErrorCode::Proto:
+            return "proto";
+        case ErrorCode::Screen:
+            return "screen";
+        case ErrorCode::Widgets:
+            return "widgets";
+        case ErrorCode::Id:
+            return "id";
+        case ErrorCode::Type:
+            return "type";
+        case ErrorCode::Rect:
+            return "rect";
+        case ErrorCode::Overlap:
+            return "overlap";
+        case ErrorCode::Font:
+            return "font";
+        case ErrorCode::Color:
+            return "colour";
+        case ErrorCode::Value:
+            return "value";
+        case ErrorCode::String:
+            return "string";
+        case ErrorCode::Field:
+            return "field";
+    }
+    return "?";
+}
+
+auto readRect(JsonVariantConst value, Rect& out) -> bool {
+    const auto parts = value.as<JsonArrayConst>();
+    if (parts.isNull() || parts.size() != 4) {
+        return false;
+    }
+    std::array<int, 4> numbers{};
+    for (size_t i = 0; i < numbers.size(); ++i) {
+        if (!parts[i].is<int>()) {
+            return false;
+        }
+        numbers[i] = parts[i].as<int>();
+    }
+    const auto [left, top, width, height] = numbers;
+    if (left < 0 || top < 0 || width < 1 || height < 1 || left + width > SCREEN_W || top + height > SCREEN_H) {
+        return false;
+    }
+    out = Rect{static_cast<int16_t>(left), static_cast<int16_t>(top), static_cast<int16_t>(width),
+               static_cast<int16_t>(height)};
+    return true;
+}
+
+auto colorOr(JsonVariantConst value, uint16_t fallback) -> uint16_t {
+    uint16_t color = fallback;
+    if (!parseColor(value.as<const char*>(), color)) {
+        return fallback;
+    }
+    return color;
+}
+
+auto readSegments(JsonVariantConst value, uint16_t color, Segments& out) -> bool {
+    out = Segments{};
+    if (value.isNull()) {
+        return true;
+    }
+    out.isNull = false;
+    if (value.is<float>()) {
+        out.items[0] = Segment{value.as<float>(), color};
+        out.count = 1;
+        return true;
+    }
+    const auto list = value.as<JsonArrayConst>();
+    if (list.isNull() || list.size() == 0) {
+        return false;
+    }
+    // [value, "#colour"]: a single value with its own colour
+    if (list.size() == 2 && list[0].is<float>()) {
+        out.count = 1;
+        out.items[0].value = list[0].as<float>();
+        return parseColor(list[1].as<const char*>(), out.items[0].color);
+    }
+    if (list.size() > MAX_SEGMENTS) {
+        return false;
+    }
+    bool valid = true;
+    for (const JsonVariantConst entry : list) {
+        const auto pair = entry.as<JsonArrayConst>();
+        Segment& segment = out.items[out.count];
+        valid = !pair.isNull() && pair.size() == 2 && pair[0].is<float>() &&
+                parseColor(pair[1].as<const char*>(), segment.color);
+        if (!valid) {
+            break;
+        }
+        segment.value = pair[0].as<float>();
+        ++out.count;
+    }
+    return valid;
+}
+
+auto validateDocument(JsonVariantConst root, Frame& frame) -> ValidationResult {
+    const JsonVariantConst proto = root["proto"];
+    if (!proto.is<int>() || proto.as<int>() != PROTO_VERSION) {
+        return {ErrorCode::Proto, -1};
+    }
+    const ErrorCode screenCode = validateScreen(root["screen"], frame.screen);
+    if (screenCode != ErrorCode::None) {
+        return {screenCode, -1};
+    }
+    const auto widgets = root["w"].as<JsonArrayConst>();
+    if (widgets.isNull() || widgets.size() > MAX_WIDGETS) {
+        return {ErrorCode::Widgets, -1};
+    }
+    std::array<Rect, MAX_WIDGETS> rects{};
+    frame.count = 0;
+    for (const JsonVariantConst item : widgets) {
+        const size_t index = frame.count;
+        const auto obj = item.as<JsonObjectConst>();
+        const ErrorCode code = obj.isNull() ? ErrorCode::Field
+                                            : validateWidget(obj, widgets, index, rects[index], frame.slots[index]);
+        if (code != ErrorCode::None) {
+            return {code, static_cast<int>(index)};
+        }
+        for (size_t other = 0; other < index; ++other) {
+            if (rects[other].intersects(rects[index])) {
+                return {ErrorCode::Overlap, static_cast<int>(index)};
+            }
+        }
+        ++frame.count;
+    }
+    return {};
+}
+
+auto layoutChanged(const Frame& previous, const Frame& next) -> bool {
+    if (previous.count != next.count || previous.screen.bg != next.screen.bg) {
+        return true;
+    }
+    for (size_t i = 0; i < next.count; ++i) {
+        const WidgetSlot* old = findSlot(previous, next.slots[i].idHash);
+        if (old == nullptr || old->rectHash != next.slots[i].rectHash) {
+            return true;
+        }
+    }
+    return false;
+}
+
+auto contentChanged(const Frame& previous, const WidgetSlot& slot) -> bool {
+    const WidgetSlot* old = findSlot(previous, slot.idHash);
+    return old == nullptr || old->contentHash != slot.contentHash;
+}
+
+auto formatNumber(double value, int decimals, char* out, size_t size) -> void {
+    if (size == 0) {
+        return;
+    }
+    out[0] = '\0';
+    if (!(std::fabs(value) < FORMAT_LIMIT)) {
+        std::strncpy(out, "--", size - 1);
+        out[size - 1] = '\0';
+        return;
+    }
+    const int places = decimals < 0 ? 0 : (decimals > MAX_DECIMALS ? MAX_DECIMALS : decimals);
+    uint64_t scale = 1;
+    for (int i = 0; i < places; ++i) {
+        scale *= 10;  // NOLINT(readability-magic-numbers)
+    }
+    const auto scaled = static_cast<uint64_t>(std::llround(std::fabs(value) * static_cast<double>(scale)));
+    // Digits are produced backwards into a scratch buffer, then copied in order
+    std::array<char, 24> digits{};  // NOLINT(readability-magic-numbers): 10 integer + 4 decimal digits fit
+    size_t length = 0;
+    uint64_t rest = scaled;
+    for (int place = 0; place < places; ++place) {
+        digits[length++] = static_cast<char>('0' + rest % 10);  // NOLINT(readability-magic-numbers)
+        rest /= 10;                                              // NOLINT(readability-magic-numbers)
+    }
+    if (places > 0) {
+        digits[length++] = '.';
+    }
+    do {
+        digits[length++] = static_cast<char>('0' + rest % 10);  // NOLINT(readability-magic-numbers)
+        rest /= 10;                                              // NOLINT(readability-magic-numbers)
+    } while (rest != 0);
+    if (value < 0 && scaled != 0) {
+        digits[length++] = '-';
+    }
+    size_t written = 0;
+    while (length > 0 && written + 1 < size) {
+        out[written++] = digits[--length];
+    }
+    out[written] = '\0';
+}
+
+// NOLINTBEGIN(readability-magic-numbers): geometry from the protocol's rendering conventions
+auto ringGeometry(const Rect& rect) -> RingGeometry {
+    const int side = rect.w < rect.h ? rect.w : rect.h;
+    RingGeometry ring;
+    ring.cx = static_cast<int16_t>(rect.x + rect.w / 2);
+    ring.cy = static_cast<int16_t>(rect.y + rect.h / 2);
+    ring.radius = static_cast<int16_t>(side / 2 - 1);
+    const int thickness = (side + 5) / 10;  // round(S / 10)
+    ring.thickness = static_cast<int16_t>(thickness > 6 ? thickness : 6);
+    ring.labelY = static_cast<int16_t>(ring.cy + (72 * ring.radius + 50) / 100);  // round(cy + 0.72 R)
+    return ring;
+}
+// NOLINTEND(readability-magic-numbers)
+
+auto scaleLength(float value, float max, int16_t length) -> int16_t {
+    if (!(max > 0) || !(value > 0)) {
+        return 0;
+    }
+    const float fraction = value >= max ? 1.0F : value / max;
+    return static_cast<int16_t>(std::lround(fraction * static_cast<float>(length)));
+}
+
+auto barSlot(int16_t extent, int16_t gap, size_t count, size_t index) -> Span {
+    if (count == 0) {
+        return {};
+    }
+    const auto bars = static_cast<int>(count);
+    const int thickness = (extent - gap * (bars - 1)) / bars;
+    if (thickness < 1) {
+        return {};
+    }
+    return {static_cast<int16_t>(static_cast<int>(index) * (thickness + gap)), static_cast<int16_t>(thickness)};
+}
+
+auto sparkY(float value, float minValue, float maxValue, const Rect& rect) -> float {
+    const auto bottom = static_cast<float>(rect.y + rect.h - 1);
+    if (!(maxValue > minValue)) {
+        return bottom;
+    }
+    float fraction = (value - minValue) / (maxValue - minValue);
+    fraction = fraction < 0 ? 0 : (fraction > 1 ? 1 : fraction);
+    return bottom - fraction * static_cast<float>(rect.h - 1);
+}
+
+auto sparkX(size_t index, size_t count, const Rect& rect) -> float {
+    if (count < 2) {
+        return static_cast<float>(rect.x);
+    }
+    return static_cast<float>(rect.x) +
+           static_cast<float>(index) * static_cast<float>(rect.w - 1) / static_cast<float>(count - 1);
+}
+
+
+auto isBuiltinIcon(const char* name) -> bool {
+    return name != nullptr &&
+           (std::strcmp(name, "dot") == 0 || std::strcmp(name, "warn") == 0 || std::strcmp(name, "check") == 0);
+}
+
+auto parseIcon(const uint8_t* data, size_t length, IconHeader& out) -> bool {
+    if (data == nullptr || length < ICON_HEADER_BYTES || data[0] != 'S' || data[1] != 'I') {
+        return false;
+    }
+    IconHeader header;
+    header.format = data[2];
+    header.width = data[3];
+    header.height = data[4];
+    if (header.width == 0 || header.height == 0 || header.width > MAX_ICON_SIDE || header.height > MAX_ICON_SIDE) {
+        return false;
+    }
+    if (header.format == ICON_FORMAT_MONO) {
+        header.pixelOffset = static_cast<uint16_t>(ICON_HEADER_BYTES);
+    } else if (header.format == ICON_FORMAT_PALETTE && length > ICON_HEADER_BYTES) {
+        header.paletteCount = data[ICON_HEADER_BYTES];
+        if (header.paletteCount == 0 || header.paletteCount > MAX_ICON_PALETTE) {
+            return false;
+        }
+        header.pixelOffset = static_cast<uint16_t>(ICON_HEADER_BYTES + 1 + ICON_PALETTE_ENTRY_BYTES * header.paletteCount);
+    } else {
+        return false;
+    }
+    const size_t total = header.pixelOffset + (static_cast<size_t>(header.width) * header.height + 1) / 2;
+    if (length < total || total > MAX_ICON_BYTES) {
+        return false;
+    }
+    header.totalBytes = static_cast<uint16_t>(total);
+    out = header;
+    return true;
+}
+
+auto iconPixel(const uint8_t* body, const IconHeader& header, uint8_t column, uint8_t row, uint16_t monoColor,
+               uint16_t& color) -> uint8_t {
+    const size_t index = static_cast<size_t>(row) * header.width + column;
+    const uint8_t packed = body[header.pixelOffset + index / 2];
+    // 4-bit values, high nibble first
+    const auto nibble = static_cast<uint8_t>((index % 2 == 0) ? (packed >> 4U) : (packed & 0x0FU));
+    if (header.format == ICON_FORMAT_MONO) {
+        color = monoColor;
+        return static_cast<uint8_t>(nibble * 17U);  // NOLINT(readability-magic-numbers): 15 * 17 = 255
+    }
+    if (nibble >= header.paletteCount) {
+        color = monoColor;
+        return 0;  // index outside the palette: transparent
+    }
+    const uint8_t* entry = body + ICON_HEADER_BYTES + 1 + ICON_PALETTE_ENTRY_BYTES * static_cast<size_t>(nibble);
+    color = static_cast<uint16_t>((entry[0] << 8U) | entry[1]);  // NOLINT(readability-magic-numbers)
+    return entry[2];
+}
+
+auto iconUrl(const char* displayUrl, const char* name, char* out, size_t size) -> bool {
+    static constexpr const char* DISPLAY_PATH = "/v1/display";
+    static constexpr const char* ICON_PATH = "/v1/icon/";
+    static constexpr const char* HEX_DIGITS = "0123456789ABCDEF";
+    const char* match = nullptr;
+    for (const char* found = std::strstr(displayUrl, DISPLAY_PATH); found != nullptr;
+         found = std::strstr(found + 1, DISPLAY_PATH)) {
+        match = found;
+    }
+    if (match == nullptr || size == 0) {
+        return false;
+    }
+    // Encoded name: unreserved characters as they are, everything else as %XX
+    std::array<char, MAX_STRING_CHARS * 3 * 3 + 1> encoded{};
+    size_t length = 0;
+    for (const char* cursor = name; *cursor != '\0' && length + 3 < encoded.size(); ++cursor) {
+        const auto chr = static_cast<unsigned char>(*cursor);
+        const bool unreserved =
+            (std::isalnum(chr) != 0 && chr < ASCII_END) || chr == '-' || chr == '.' || chr == '_' || chr == '~';
+        if (unreserved) {
+            encoded[length++] = static_cast<char>(chr);
+        } else {
+            encoded[length++] = '%';
+            encoded[length++] = HEX_DIGITS[chr >> 4U];    // NOLINT(readability-magic-numbers)
+            encoded[length++] = HEX_DIGITS[chr & 0x0FU];  // NOLINT(readability-magic-numbers)
+        }
+    }
+    const int written = std::snprintf(out, size, "%.*s%s%s", static_cast<int>(match - displayUrl), displayUrl,
+                                      ICON_PATH, encoded.data());
+    return written > 0 && static_cast<size_t>(written) < size;
+}
+
+
+auto readGradient(JsonVariantConst value, Gradient& out) -> ErrorCode {
+    out = Gradient{};
+    if (value.isNull()) {
+        return ErrorCode::None;
+    }
+    const auto stops = value.as<JsonArrayConst>();
+    if (stops.isNull() || stops.size() < MIN_GRADIENT_STOPS || stops.size() > MAX_GRADIENT_STOPS) {
+        return ErrorCode::Value;
+    }
+    ErrorCode code = ErrorCode::None;
+    for (const JsonVariantConst entry : stops) {
+        const auto pair = entry.as<JsonArrayConst>();
+        GradientStop& stop = out.stops[out.count];
+        if (pair.isNull() || pair.size() != 2 || !pair[0].is<float>()) {
+            code = ErrorCode::Value;
+        } else if (!parseColor888(pair[1].as<const char*>(), stop.rgb)) {
+            code = ErrorCode::Color;
+        } else {
+            stop.value = pair[0].as<float>();
+            if (out.count > 0 && !(stop.value > out.stops[out.count - 1].value)) {
+                code = ErrorCode::Value;  // stops must ascend strictly
+            }
+        }
+        if (code != ErrorCode::None) {
+            out = Gradient{};
+            return code;
+        }
+        ++out.count;
+    }
+    return ErrorCode::None;
+}
+
+// NOLINTBEGIN(readability-magic-numbers): 8-bit channel arithmetic
+auto gradientColor(const Gradient& gradient, float value) -> uint16_t {
+    if (gradient.count == 0) {
+        return DEFAULT_FG;
+    }
+    if (!(value > gradient.stops[0].value)) {
+        return rgb565(gradient.stops[0].rgb);  // also NaN
+    }
+    const GradientStop& last = gradient.stops[gradient.count - 1];
+    if (value >= last.value) {
+        return rgb565(last.rgb);
+    }
+    size_t upper = 1;
+    while (upper < gradient.count - 1 && value > gradient.stops[upper].value) {
+        ++upper;
+    }
+    const GradientStop& low = gradient.stops[upper - 1];
+    const GradientStop& high = gradient.stops[upper];
+    const float fraction = (value - low.value) / (high.value - low.value);
+    uint32_t rgb = 0;
+    for (const uint32_t shift : {16U, 8U, 0U}) {
+        const auto from = static_cast<float>((low.rgb >> shift) & 0xFFU);
+        const auto to = static_cast<float>((high.rgb >> shift) & 0xFFU);
+        const auto channel = static_cast<uint32_t>(std::lround(from + (to - from) * fraction));
+        rgb |= (channel & 0xFFU) << shift;
+    }
+    return rgb565(rgb);
+}
+// NOLINTEND(readability-magic-numbers)
+
+auto sparkRowValue(int row, float minValue, float maxValue, const Rect& rect) -> float {
+    if (rect.h < 2) {
+        return maxValue;
+    }
+    const auto bottom = static_cast<float>(rect.y + rect.h - 1);
+    return minValue + (bottom - static_cast<float>(row)) / static_cast<float>(rect.h - 1) * (maxValue - minValue);
+}
+
+// NOLINTEND(readability-misplaced-array-index)
+}  // namespace renderer
