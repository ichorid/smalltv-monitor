@@ -0,0 +1,33 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Draws protocol v1 widgets with TFT_eSPI (anti-aliased arcs, rounded rects and VLW smooth fonts).
+#pragma once
+
+#include <ArduinoJson.h>
+
+#include "renderer/WidgetModel.h"
+
+namespace renderer {
+
+// Corner badge shown while the PC is unreachable
+constexpr Rect OFFLINE_DOT_RECT{228, 0, 12, 12};
+
+class WidgetPainter {
+   public:
+    // Creates and initialises TFT_eSPI once; the panel keeps Arduino_GFX's rotation setting
+    static auto begin() -> bool;
+    // Bracket every drawing pass: TFT_eSPI and Arduino_GFX (used by the rest of the firmware) both cache
+    // the panel's address window, so each must forget it after the other one has drawn
+    static auto beginPass() -> void;
+    static auto endPass() -> void;
+
+    static auto fillScreen(uint16_t color) -> void;
+    static auto fillRect(const Rect& rect, uint16_t color) -> void;
+    // Repaints the widget's whole rect. `clearFirst` paints the background before the content (needed after
+    // anything else drew there); otherwise widgets overwrite their old pixels in place to avoid flicker.
+    // Returns false when the widget could not be drawn completely yet (PC icon not cached).
+    static auto drawWidget(JsonObjectConst widget, uint16_t screenBg, bool clearFirst) -> bool;
+    static auto drawOfflineDot(uint16_t screenBg) -> void;
+    static auto drawWaiting(const char* address, const char* url) -> void;
+};
+
+}  // namespace renderer
