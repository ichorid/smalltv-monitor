+// SPDX-License-Identifier: GPL-3.0-or-later
+// Host test for src/renderer/WidgetModel.cpp: g++ only, no Arduino. Run test/host/run.sh.
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <string>
+
+#include "renderer/WidgetModel.h"
+
+using renderer::ErrorCode;
+using renderer::Frame;
+
+namespace {
+
+int failures = 0;
+int checks = 0;
+
+void expect(bool condition, const char* what, int line) {
+    ++checks;
+    if (!condition) {
+        ++failures;
+        std::printf("FAIL line %d: %s\n", line, what);
+    }
+}
+#define EXPECT(cond) expect((cond), #cond, __LINE__)
+
+// The example from docs/WIDGET-PROTOCOL.md
+const char* const SPEC_EXAMPLE = R"({
+  "proto": 1,
+  "screen": { "bg": "#101418", "bri": 80, "poll_ms": 1000, "offline_bri": 5, "offline_dim_s": 300 },
+  "w": [
+    { "id": "title", "t": "text",  "r": [8, 4, 224, 18], "f": 0, "c": "#ffffff", "text": "PC" },
+    { "id": "cpu",   "t": "ring",  "r": [16, 26, 92, 92], "f": 1, "label": "CPU", "max": 100,
+      "v": [[24, "#fd8c00"], [9, "#f2384c"]] },
+    { "id": "gpu",   "t": "ring",  "r": [132, 26, 92, 92], "f": 1, "label": "GPU", "max": 100,
+      "v": 82, "c": "#f2384c" },
+    { "id": "ram",   "t": "bar",   "r": [8, 128, 224, 12], "label": "RAM", "max": 64,
+      "v": [[27.1, "#a855f7"], [21.4, "#4b3a6b"]] },
+    { "id": "cores", "t": "bars",  "r": [8, 146, 224, 36], "dir": "v", "max": 100, "gap": 2,
+      "v": [[[40, "#fd8c00"], [8, "#f2384c"]], 12, 95, 3, 7, 60, 22, 18, 5, 5, 9, 31, 2, 4, 70, 11] ,
+      "c": "#fd8c00" },
+    { "id": "cpuh",  "t": "spark", "r": [8, 186, 224, 24], "max": 100, "c": "#fd8c00",
+      "v": [31, 35, 37, 36, 40, 52, 48, 39, 37, 33, 30, 29, 35, 41, 39] },
+    { "id": "temp",  "t": "value", "r": [8, 214, 112, 22], "f": 0, "a": "l", "unit": "°C", "v": 51, "c": "#ffffff" },
+    { "id": "pwr",   "t": "value", "r": [120, 214, 112, 22], "f": 0, "a": "r", "unit": "W", "v": 212, "c": "#f2384c" }
+  ]
+})";
+
+auto validate(const std::string& json, Frame& frame) -> renderer::ValidationResult {
+    JsonDocument doc;
+    const DeserializationError error = deserializeJson(doc, json);
+    if (error) {
+        std::printf("parse error: %s\n", error.c_str());
+        return {ErrorCode::Json, -1};
+    }
+    return renderer::validateDocument(doc.as<JsonVariantConst>(), frame);
+}
+
+auto codeOf(const std::string& json) -> ErrorCode {
+    Frame frame;
+    return validate(json, frame).code;
+}
+
+// Wraps one widget into a minimal valid document
+auto one(const std::string& widget) -> std::string { return R"({"proto":1,"w":[)" + widget + "]}"; }
+
+auto replace(std::string text, const std::string& from, const std::string& to) -> std::string {
+    const size_t pos = text.find(from);
+    if (pos != std::string::npos) {
+        text.replace(pos, from.size(), to);
+    }
+    return text;
+}
+
+void testSpecExample() {
+    Frame first;
+    const auto result = validate(SPEC_EXAMPLE, first);
+    EXPECT(result.code == ErrorCode::None);
+    EXPECT(first.count == 8);
+    EXPECT(first.screen.bri == 80);
+    EXPECT(first.screen.pollMs == 1000);
+    EXPECT(first.screen.bg == 0x10A3);  // #101418
+
+    Frame same;
+    validate(SPEC_EXAMPLE, same);
+    EXPECT(!renderer::layoutChanged(first, same));
+    for (size_t i = 0; i < same.count; ++i) {
+        EXPECT(!renderer::contentChanged(first, same.slots[i]));
+    }
+
+    // One value changes: only that widget is dirty, layout unchanged
+    Frame valueChanged;
+    validate(replace(SPEC_EXAMPLE, R"("v": 82)", R"("v": 83)"), valueChanged);
+    EXPECT(!renderer::layoutChanged(first, valueChanged));
+    size_t dirty = 0;
+    for (size_t i = 0; i < valueChanged.count; ++i) {
+        dirty += renderer::contentChanged(first, valueChanged.slots[i]) ? 1 : 0;
+    }
+    EXPECT(dirty == 1);
+    EXPECT(renderer::contentChanged(first, valueChanged.slots[2]));
+
+    // A rect moves: full redraw
+    Frame moved;
+    EXPECT(validate(replace(SPEC_EXAMPLE, "[8, 4, 224, 18]", "[8, 4, 220, 18]"), moved).code == ErrorCode::None);
+    EXPECT(renderer::layoutChanged(first, moved));
+
+    // Screen background changes: full redraw
+    Frame newBg;
+    validate(replace(SPEC_EXAMPLE, "#101418", "#000000"), newBg);
+    EXPECT(renderer::layoutChanged(first, newBg));
+
+    // A widget's own background changes: full redraw (in-place repaints assume an unchanged background)
+    Frame widgetBg;
+    validate(replace(SPEC_EXAMPLE, R"("id": "title", "t": "text")", R"("id": "title", "bg": "#202020", "t": "text")"),
+             widgetBg);
+    EXPECT(widgetBg.count == 8 && renderer::layoutChanged(first, widgetBg));
+
+    // Same widgets in another order: the set of (id, rect) is unchanged
+    Frame reordered;
+    const std::string swapped = replace(replace(SPEC_EXAMPLE, R"("id": "temp")", R"("id": "XXXX")"),
+                                        R"("id": "pwr")", R"("id": "temp")");
+    validate(replace(swapped, R"("id": "XXXX")", R"("id": "pwr")"), reordered);
+    EXPECT(renderer::layoutChanged(first, reordered));  // ids swapped rects: geometry did change
+    const std::string doc2 = R"({"proto":1,"w":[{"id":"a","t":"text","r":[0,0,10,10]},{"id":"b","t":"text","r":[10,0,10,10]}]})";
+    const std::string doc2r = R"({"proto":1,"w":[{"id":"b","t":"text","r":[10,0,10,10]},{"id":"a","t":"text","r":[0,0,10,10]}]})";
+    Frame ordered;
+    Frame reversed;
+    validate(doc2, ordered);
+    validate(doc2r, reversed);
+    EXPECT(!renderer::layoutChanged(ordered, reversed));
+
+    // A widget disappears
+    Frame fewer;
+    validate(R"({"proto":1,"w":[{"id":"a","t":"text","r":[0,0,10,10]}]})", fewer);
+    EXPECT(renderer::layoutChanged(ordered, fewer));
+}
