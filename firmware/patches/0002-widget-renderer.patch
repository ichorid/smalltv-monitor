diff --git a/src/renderer/IconCache.cpp b/src/renderer/IconCache.cpp
new file mode 100644
index 0000000..ba396ea
--- /dev/null
+++ b/src/renderer/IconCache.cpp
@@ -0,0 +1,165 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// PC icon cache: least recently used of CAPACITY entries is evicted; bodies live on the heap (<= 342 B each).
+#ifdef DISPLAY_URL
+#include "renderer/IconCache.h"
+
+#include <Arduino.h>
+#include <ESP8266HTTPClient.h>
+#include <ESP8266WiFi.h>
+#include <Logger.h>
+#include <WiFiClient.h>
+
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace renderer {
+
+namespace {
+
+constexpr uint16_t FETCH_TIMEOUT_MS = 800;
+constexpr uint32_t RETRY_AFTER_MS = 30000;   // a failed icon is not requested again before this
+constexpr uint32_t ICON_HEAP_RESERVE = 8192;  // cached icons never take the heap below this
+constexpr size_t URL_SIZE = 256;
+constexpr size_t LOG_SIZE = 96;
+
+struct Entry {
+    uint32_t nameHash = 0;
+    uint32_t contentHash = 0;
+    uint32_t lastUsed = 0;
+    uint8_t* body = nullptr;
+    IconHeader header;
+};
+
+std::array<Entry, IconCache::CAPACITY> entries{};
+uint32_t useCounter = 0;
+
+bool pending = false;
+std::array<char, MAX_STRING_CHARS * 3 + 1> pendingName{};  // up to 31 UTF-8 characters
+uint32_t pendingHash = 0;
+
+bool hasFailure = false;
+uint32_t failedNameHash = 0;
+uint32_t failedHash = 0;
+uint32_t failedAtMs = 0;
+
+auto store(uint32_t nameHash, uint32_t contentHash, const uint8_t* data, const IconHeader& header) -> bool {
+    // NOLINTNEXTLINE(readability-static-accessed-through-instance)
+    if (ESP.getFreeHeap() < header.totalBytes + ICON_HEAP_RESERVE) {
+        return false;
+    }
+    Entry* target = nullptr;
+    for (Entry& entry : entries) {  // same name: the icon changed, replace it
+        if (entry.body != nullptr && entry.nameHash == nameHash) {
+            target = &entry;
+        }
+    }
+    for (Entry& entry : entries) {
+        if (target == nullptr && entry.body == nullptr) {
+            target = &entry;
+        }
+    }
+    if (target == nullptr) {  // full: evict the least recently used
+        target = entries.data();
+        for (Entry& entry : entries) {
+            if (entry.lastUsed < target->lastUsed) {
+                target = &entry;
+            }
+        }
+    }
+    auto* body = static_cast<uint8_t*>(std::malloc(header.totalBytes));
+    if (body == nullptr) {
+        return false;
+    }
+    std::memcpy(body, data, header.totalBytes);
+    std::free(target->body);
+    *target = Entry{nameHash, contentHash, ++useCounter, body, header};
+    return true;
+}
+
+// Returns an error description, or nullptr when the icon was stored
+auto download(const char* url, uint32_t nameHash, uint32_t contentHash) -> const char* {
+    if (WiFi.status() != WL_CONNECTED) {
+        return "no Wi-Fi";
+    }
+    WiFiClient client;
+    HTTPClient http;
+    http.setTimeout(FETCH_TIMEOUT_MS);
+    http.useHTTP10(true);
+    if (!http.begin(client, url)) {
+        return "bad URL";
+    }
+    if (http.GET() != HTTP_CODE_OK) {
+        http.end();
+        return "HTTP error";
+    }
+    const int length = http.getSize();
+    if (length < static_cast<int>(ICON_HEADER_BYTES) || length > static_cast<int>(MAX_ICON_BYTES)) {
+        http.end();
+        return "bad Content-Length";
+    }
+    std::array<uint8_t, MAX_ICON_BYTES> data{};
+    const size_t got = http.getStream().readBytes(reinterpret_cast<char*>(data.data()), static_cast<size_t>(length));
+    http.end();
+    IconHeader header;
+    if (got != static_cast<size_t>(length) || !parseIcon(data.data(), got, header)) {
+        return "bad body";
+    }
+    return store(nameHash, contentHash, data.data(), header) ? nullptr : "no memory";
+}
+
+}  // namespace
+
+auto IconCache::find(const char* name, uint32_t hash, const uint8_t*& body, IconHeader& header) -> bool {
+    const uint32_t nameHash = fnv1a(name);
+    for (Entry& entry : entries) {
+        if (entry.body != nullptr && entry.nameHash == nameHash && entry.contentHash == hash) {
+            entry.lastUsed = ++useCounter;
+            body = entry.body;
+            header = entry.header;
+            return true;
+        }
+    }
+    return false;
+}
+
+auto IconCache::request(const char* name, uint32_t hash) -> void {
+    const uint32_t nameHash = fnv1a(name);
+    const bool recentlyFailed = hasFailure && failedNameHash == nameHash && failedHash == hash &&
+                                millis() - failedAtMs < RETRY_AFTER_MS;
+    if (pending || recentlyFailed) {
+        return;
+    }
+    std::strncpy(pendingName.data(), name, pendingName.size() - 1);
+    pendingName.back() = '\0';
+    pendingHash = hash;
+    pending = true;
+}
+
+auto IconCache::fetchPending(const char* displayUrl) -> void {
+    if (!pending) {
+        return;
+    }
+    pending = false;
+    std::array<char, URL_SIZE> url{};
+    const char* error = "URL has no /v1/display";
+    const uint32_t nameHash = fnv1a(pendingName.data());
+    if (iconUrl(displayUrl, pendingName.data(), url.data(), url.size())) {
+        error = download(url.data(), nameHash, pendingHash);
+    }
+    if (error == nullptr) {
+        hasFailure = false;
+        return;
+    }
+    hasFailure = true;
+    failedNameHash = nameHash;
+    failedHash = pendingHash;
+    failedAtMs = millis();
+    std::array<char, LOG_SIZE> message{};
+    std::snprintf(message.data(), message.size(), "Icon '%.40s' not loaded: %s", pendingName.data(), error);
+    Logger::warn(message.data(), "IconCache");
+}
+
+}  // namespace renderer
+#endif
diff --git a/src/renderer/RendererManager.cpp b/src/renderer/RendererManager.cpp
new file mode 100644
index 0000000..a5512da
--- /dev/null
+++ b/src/renderer/RendererManager.cpp
@@ -0,0 +1,314 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Polls GET /v1/display, validates the screen, and redraws only what changed (docs/WIDGET-PROTOCOL.md).
+// Nothing here writes to flash: brightness and all state live in RAM.
+#ifdef DISPLAY_URL
+#include "renderer/RendererManager.h"
+
+#include <ArduinoJson.h>
+#include <ESP8266HTTPClient.h>
+#include <ESP8266WiFi.h>
+#include <Logger.h>
+#include <Updater.h>
+#include <WiFiClient.h>
+
+#include <array>
+#include <cctype>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+#include "config/ConfigManager.h"
+#include "display/DisplayManager.h"
+#include "project_version.h"
+#include "renderer/IconCache.h"
+#include "renderer/WidgetModel.h"
+#include "renderer/WidgetPainter.h"
+
+namespace {
+
+using renderer::ErrorCode;
+using renderer::Frame;
+
+constexpr uint16_t FETCH_TIMEOUT_MS = 800;
+// A single lost poll (Wi-Fi retry, slow reply) must not mark the PC offline
+constexpr uint8_t OFFLINE_AFTER_FAILURES = 3;
+// The JSON document may only allocate while this much heap stays free for Wi-Fi, the web server and fonts
+constexpr uint32_t PARSE_HEAP_RESERVE = 6144;
+constexpr uint32_t PWM_FREQUENCY_HZ = 1000;
+constexpr uint32_t PWM_RANGE = 1000;
+constexpr uint32_t PERCENT = 100;
+constexpr uint32_t MS_PER_S = 1000;
+constexpr size_t URL_SIZE = 256;
+constexpr size_t FW_SIZE = 48;
+constexpr size_t LOG_SIZE = 96;
+constexpr int UNKNOWN_BRIGHTNESS = -1;
+constexpr const char* FW_SUFFIX = "-w2";  // widget protocol v1, spark `u` series
+constexpr uint32_t INCOMPLETE_MARK = 1;
+
+// Refuses allocations that would eat into PARSE_HEAP_RESERVE; ArduinoJson then reports NoMemory
+class HeapBudgetAllocator : public ArduinoJson::Allocator {
+   public:
+    // Virtual overrides; `pio check` misreports them as static-able (it cannot parse ArduinoJson's base class)
+    // NOLINTNEXTLINE(readability-convert-member-functions-to-static)
+    auto allocate(size_t size) -> void* override { return fits(size) ? std::malloc(size) : nullptr; }
+    auto deallocate(void* pointer) -> void override { std::free(pointer); }
+    // NOLINTNEXTLINE(readability-convert-member-functions-to-static)
+    auto reallocate(void* pointer, size_t newSize) -> void* override {
+        return fits(newSize) ? std::realloc(pointer, newSize) : nullptr;
+    }
+
+   private:
+    static auto fits(size_t size) -> bool {
+        // NOLINTNEXTLINE(readability-static-accessed-through-instance)
+        return ESP.getFreeHeap() >= size + PARSE_HEAP_RESERVE && ESP.getMaxFreeBlockSize() >= size;
+    }
+};
+
+const char* displayUrl = "";
+std::array<char, FW_SIZE> fwParam{};
+HeapBudgetAllocator allocator;
+
+std::array<Frame, 2> frames{};  // frames[current]: what is on screen; the other one receives the next poll
+size_t current = 0;
+bool hasFrame = false;
+bool needFullRedraw = true;
+bool dotShown = false;
+bool offline = false;
+bool paused = false;
+uint8_t failures = 0;
+uint32_t lastPollMs = 0;
+uint32_t lastValidMs = 0;
+uint32_t seenDrawEpoch = 0;
+int brightness = UNKNOWN_BRIGHTNESS;
+ErrorCode lastError = ErrorCode::None;
+ErrorCode loggedError = ErrorCode::None;
+int lastErrorWidget = -1;
+
+auto screen() -> const renderer::ScreenConfig& { return frames[current].screen; }
+
+// screen.bri / offline_bri 0..100 -> PWM on the active-low backlight pin; never stored in flash
+auto setBrightness(uint8_t percent) -> void {
+    if (brightness == percent) {
+        return;
+    }
+    brightness = percent;
+    const uint32_t duty = std::min<uint32_t>(percent, PERCENT) * PWM_RANGE / PERCENT;
+    analogWrite(LCD_BACKLIGHT_GPIO, static_cast<int>(LCD_BACKLIGHT_ACTIVE_LOW ? PWM_RANGE - duty : duty));
+}
+
+// Percent-encodes the firmware version once (git describe output is mostly URL-safe, but not guaranteed)
+auto encodeFirmwareVersion() -> void {
+    static constexpr const char* HEX_DIGITS = "0123456789ABCDEF";
+    size_t length = 0;
+    const auto append = [&](char chr) {
+        if (length + 1 < fwParam.size()) {
+            fwParam[length++] = chr;
+        }
+    };
+    for (const char* cursor = PROJECT_VER_STR; *cursor != '\0'; ++cursor) {
+        const auto chr = static_cast<unsigned char>(*cursor);
+        if (std::isalnum(chr) != 0 || chr == '-' || chr == '.' || chr == '_' || chr == '~') {
+            append(static_cast<char>(chr));
+        } else if (length + 3 < fwParam.size()) {
+            append('%');
+            append(HEX_DIGITS[chr >> 4U]);    // NOLINT(readability-magic-numbers)
+            append(HEX_DIGITS[chr & 0x0FU]);  // NOLINT(readability-magic-numbers)
+        }
+    }
+    for (const char* cursor = FW_SUFFIX; *cursor != '\0'; ++cursor) {
+        append(*cursor);
+    }
+    fwParam[length] = '\0';
+}
+
+auto buildRequestUrl(std::array<char, URL_SIZE>& url) -> bool {
+    const char separator = std::strchr(displayUrl, '?') == nullptr ? '?' : '&';
+    const int written = std::snprintf(
+        url.data(), url.size(), "%s%cfw=%s&heap=%u&blk=%u&up=%lu&rssi=%d&err=%u", displayUrl, separator,
+        fwParam.data(), static_cast<unsigned>(ESP.getFreeHeap()),  // NOLINT(readability-static-accessed-through-instance)
+        static_cast<unsigned>(ESP.getMaxFreeBlockSize()),          // NOLINT(readability-static-accessed-through-instance)
+        static_cast<unsigned long>(millis() / MS_PER_S), static_cast<int>(WiFi.RSSI()),
+        static_cast<unsigned>(lastError));
+    return written > 0 && static_cast<size_t>(written) < url.size();
+}
+
+auto drawWaitingScreen() -> void {
+    const char* shownUrl = displayUrl;
+    if (std::strncmp(shownUrl, "http://", std::strlen("http://")) == 0) {
+        shownUrl += std::strlen("http://");
+    }
+    renderer::WidgetPainter::beginPass();
+    renderer::WidgetPainter::drawWaiting(("IP " + WiFi.localIP().toString()).c_str(), shownUrl);
+    renderer::WidgetPainter::endPass();
+}
+
+auto drawDot() -> void {
+    renderer::WidgetPainter::beginPass();
+    renderer::WidgetPainter::drawOfflineDot(screen().bg);
+    renderer::WidgetPainter::endPass();
+    dotShown = true;
+}
+
+auto transportFailed() -> ErrorCode {
+    if (failures < OFFLINE_AFTER_FAILURES) {
+        ++failures;
+    }
+    if (failures >= OFFLINE_AFTER_FAILURES) {
+        offline = true;  // the last frame stays up; the dot and later dimming say it is stale
+        if (!dotShown) {
+            drawDot();
+        }
+    }
+    return ErrorCode::Http;
+}
+
+// ArduinoJson's operator[] (obj["key"]) is misreported by readability-misplaced-array-index under `pio check`,
+// whose clang-tidy cannot find its resource headers and parses ArduinoJson in error recovery (a correct parse
+// shows CXXOperatorCallExpr). Upstream suppresses the same check on these accesses.
+// NOLINTBEGIN(readability-misplaced-array-index)
+// Full redraw when the layout changed (or the panel was used by something else); otherwise only widgets whose
+// JSON changed, plus those under the offline dot when it goes away
+auto drawFrame(JsonArrayConst widgets, Frame& next) -> void {
+    const Frame& previous = frames[current];
+    const bool full = needFullRedraw || !hasFrame || renderer::layoutChanged(previous, next);
+    renderer::WidgetPainter::beginPass();
+    if (full) {
+        renderer::WidgetPainter::fillScreen(next.screen.bg);
+    } else if (dotShown) {
+        renderer::WidgetPainter::fillRect(renderer::OFFLINE_DOT_RECT, next.screen.bg);
+    }
+    size_t index = 0;
+    for (const JsonVariantConst item : widgets) {
+        const auto widget = item.as<JsonObjectConst>();
+        renderer::WidgetSlot& slot = next.slots[index++];
+        renderer::Rect rect;
+        renderer::readRect(widget["r"], rect);
+        const bool underDot = !full && dotShown && rect.intersects(renderer::OFFLINE_DOT_RECT);
+        if (full || underDot || renderer::contentChanged(previous, slot)) {
+            if (!renderer::WidgetPainter::drawWidget(widget, next.screen.bg, full || underDot)) {
+                slot.contentHash ^= INCOMPLETE_MARK;  // not fully drawn (icon pending): redraw on the next poll
+            }
+            yield();
+        }
+    }
+    renderer::WidgetPainter::endPass();
+}
+
+auto fetchAndDraw() -> ErrorCode {
+    lastErrorWidget = -1;
+    if (WiFi.status() != WL_CONNECTED) {
+        return transportFailed();
+    }
+    std::array<char, URL_SIZE> url{};
+    if (!buildRequestUrl(url)) {
+        return transportFailed();
+    }
+    WiFiClient client;
+    HTTPClient http;
+    http.setTimeout(FETCH_TIMEOUT_MS);
+    http.useHTTP10(true);  // no chunked encoding: Content-Length is checked before parsing
+    if (!http.begin(client, url.data())) {
+        return transportFailed();
+    }
+    if (http.GET() != HTTP_CODE_OK) {
+        http.end();
+        return transportFailed();
+    }
+    failures = 0;
+    const int length = http.getSize();
+    if (length < 0 || length > renderer::MAX_BODY_BYTES) {
+        http.end();
+        return ErrorCode::Size;
+    }
+    // Parsed straight from the socket: no body buffer, and the reader stops at Content-Length
+    JsonDocument doc(&allocator);
+    renderer::BoundedReader<WiFiClient> reader(http.getStream(), static_cast<size_t>(length));
+    const DeserializationError error = deserializeJson(doc, reader);
+    http.end();
+    if (error == DeserializationError::NoMemory || doc.overflowed()) {
+        return ErrorCode::NoMemory;
+    }
+    if (error) {
+        return ErrorCode::Json;
+    }
+    Frame& next = frames[1 - current];
+    const renderer::ValidationResult result = renderer::validateDocument(doc.as<JsonVariantConst>(), next);
+    if (result.code != ErrorCode::None) {
+        lastErrorWidget = result.widget;
+        return result.code;
+    }
+    yield();
+    drawFrame(doc["w"].as<JsonArrayConst>(), next);
+    current = 1 - current;
+    hasFrame = true;
+    needFullRedraw = false;
+    dotShown = false;
+    offline = false;
+    lastValidMs = millis();
+    setBrightness(screen().bri);
+    return ErrorCode::None;
+}
+
+auto logErrorChange(ErrorCode code) -> void {
+    if (code == loggedError) {
+        return;
+    }
+    loggedError = code;
+    if (code == ErrorCode::None) {
+        Logger::info("Display screen accepted", "Renderer");
+        return;
+    }
+    std::array<char, LOG_SIZE> message{};
+    std::snprintf(message.data(), message.size(), "Display poll failed: %s (err=%u, widget %d)",
+                  renderer::errorName(code), static_cast<unsigned>(code), lastErrorWidget);
+    Logger::warn(message.data(), "Renderer");
+}
+
+}  // namespace
+
+// NOLINTEND(readability-misplaced-array-index)
+void RendererManager::begin(const char* url) {
+    displayUrl = url;
+    encodeFirmwareVersion();
+    // DisplayManager switched the backlight fully on with digitalWrite() at boot and does not touch it again,
+    // so from here on the PWM below owns the pin
+    analogWriteFreq(PWM_FREQUENCY_HZ);
+    analogWriteRange(PWM_RANGE);
+    brightness = UNKNOWN_BRIGHTNESS;
+    renderer::WidgetPainter::begin();
+    seenDrawEpoch = DisplayManager::drawEpoch();
+    drawWaitingScreen();
+    const uint32_t now = millis();
+    lastPollMs = now - renderer::DEFAULT_POLL_MS;
+    lastValidMs = now;
+    Logger::info("Widget renderer started", "Renderer");
+}
+
+void RendererManager::update() {
+    // The web UI may take over the panel (GIF playback, firmware upload): stay off it, redraw everything after
+    if (DisplayManager::isGifPlaying() || Update.isRunning()) {
+        paused = true;
+        return;
+    }
+    if (paused || DisplayManager::drawEpoch() != seenDrawEpoch) {
+        paused = false;
+        seenDrawEpoch = DisplayManager::drawEpoch();
+        needFullRedraw = true;
+        dotShown = false;
+        if (!hasFrame) {
+            drawWaitingScreen();
+        }
+    }
+    const uint32_t now = millis();
+    if (offline && (now - lastValidMs) / MS_PER_S >= screen().offlineDimS) {
+        setBrightness(screen().offlineBri);
+    }
+    if (now - lastPollMs < screen().pollMs) {
+        return;
+    }
+    lastPollMs = now;
+    lastError = fetchAndDraw();
+    logErrorChange(lastError);
+    renderer::IconCache::fetchPending(displayUrl);  // at most one icon request per poll
+}
+#endif
