+// SPDX-License-Identifier: GPL-3.0-or-later
+// RAM cache of PC-served icons (GET .../v1/icon/<name>), keyed by (name, content hash `h`). Never in flash.
+#pragma once
+
+#include <cstdint>
+
+#include "renderer/WidgetModel.h"
+
+namespace renderer {
+
+class IconCache {
+   public:
+    static constexpr size_t CAPACITY = 16;
+
+    // Looks up (name, hash) and marks it recently used; `body` points at the cached response body
+    static auto find(const char* name, uint32_t hash, const uint8_t*& body, IconHeader& header) -> bool;
+    // Remembers the first miss of a poll; fetchPending() downloads it
+    static auto request(const char* name, uint32_t hash) -> void;
+    // At most one HTTP request: fetches the pending icon, if any. Call once per poll, after drawing.
+    static auto fetchPending(const char* displayUrl) -> void;
+};
+
+}  // namespace renderer
