+auto main() -> int {
+    testSpecExample();
+    testRejections();
+    testHelpers();
+    testBoundedReader();
+    testIcons();
+    testGradient();
+    testUnderSeries();
+    std::printf("%d checks, %d failures\n", checks, failures);
+    return failures == 0 ? 0 : 1;
