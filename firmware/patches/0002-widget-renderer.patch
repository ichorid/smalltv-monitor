+// SPDX-License-Identifier: GPL-3.0-or-later
+// Server-driven display: polls GET /v1/display and draws the widgets it describes (docs/WIDGET-PROTOCOL.md).
+// Replaces DashboardManager when the firmware is built with -DDISPLAY_URL (env:renderer).
+#pragma once
+
+#include <Arduino.h>
+
+class RendererManager {
+   public:
+    // Takes over the panel (TFT_eSPI) and the backlight (PWM); call once Wi-Fi is in station mode
+    static void begin(const char* displayUrl);
+    // Call every loop(): polls every screen.poll_ms, redraws what changed, handles offline and dimming
+    static void update();
+};
diff --git a/include/renderer/WidgetModel.h b/include/renderer/WidgetModel.h
new file mode 100644
index 0000000..b008ac6
--- /dev/null
+++ b/include/renderer/WidgetModel.h
@@ -0,0 +1,257 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Widget protocol v1 model: validation, change detection and geometry for the /v1/display renderer.
+// Plain C++ on top of ArduinoJson (no Arduino.h), so test/host can compile it with g++.
+#pragma once
+
+#include <ArduinoJson.h>
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace renderer {
+
+constexpr int16_t SCREEN_W = 240;
+constexpr int16_t SCREEN_H = 240;
+constexpr int32_t MAX_BODY_BYTES = 4096;
+constexpr size_t MAX_WIDGETS = 32;
+constexpr size_t MAX_BARS = 32;
+constexpr size_t MAX_SEGMENTS = 4;
+constexpr size_t MAX_SPARK = 120;
+constexpr size_t MAX_STRING_CHARS = 31;
+constexpr uint8_t FONT_COUNT = 3;
+constexpr int PROTO_VERSION = 1;
+
+// Defaults from the protocol's rendering conventions
+constexpr uint16_t DEFAULT_FG = 0xFFFF;     // #ffffff (c, tc)
+constexpr uint16_t DEFAULT_LABEL = 0x8CB3;  // #8b949e (lc)
+constexpr uint16_t DEFAULT_TRACK = 0x1905;  // #1c2128 (track)
+constexpr uint16_t DEFAULT_BG = 0x0000;     // screen.bg when absent
+constexpr uint8_t DEFAULT_BRI = 100;
+constexpr uint32_t DEFAULT_POLL_MS = 1000;
+constexpr uint32_t MIN_POLL_MS = 250;
+constexpr uint32_t MAX_POLL_MS = 60000;
+constexpr uint8_t DEFAULT_OFFLINE_BRI = 5;
+constexpr uint32_t DEFAULT_OFFLINE_DIM_S = 300;
+constexpr int DEFAULT_PANEL_RADIUS = 6;
+constexpr int DEFAULT_BARS_GAP = 1;
+constexpr int MAX_DECIMALS = 4;
+constexpr size_t MIN_GRADIENT_STOPS = 2;
+constexpr size_t MAX_GRADIENT_STOPS = 8;
+constexpr int DEFAULT_GRADIENT_FILL_PERCENT = 35;
+constexpr size_t MAX_ICON_BYTES = 512;
+constexpr size_t ICON_HEADER_BYTES = 5;
+constexpr uint8_t ICON_FORMAT_MONO = 1;
+constexpr uint8_t ICON_FORMAT_PALETTE = 2;
+constexpr uint8_t MAX_ICON_PALETTE = 16;
+constexpr size_t ICON_PALETTE_ENTRY_BYTES = 3;
+constexpr uint8_t MAX_ICON_SIDE = 24;
+
+// Reported to the PC as the numeric `err` query parameter (0 = last poll was fine)
+enum class ErrorCode : uint8_t {
+    None = 0,
+    Http = 1,       // connect failure, timeout, or HTTP status other than 200
+    Size = 2,       // Content-Length missing or above MAX_BODY_BYTES
+    Json = 3,       // malformed or truncated JSON
+    NoMemory = 4,   // document did not fit in the heap budget
+    Proto = 5,      // missing or unsupported "proto"
+    Screen = 6,     // invalid "screen" field
+    Widgets = 7,    // "w" missing, not an array, or more than MAX_WIDGETS
+    Id = 8,         // missing, too long or duplicate widget id
+    Type = 9,       // unknown widget type
+    Rect = 10,      // malformed rect or outside 240x240
+    Overlap = 11,   // two widget rects intersect
+    Font = 12,      // font index outside 0..2
+    Color = 13,     // colour not "#rrggbb"
+    Value = 14,     // "v" has the wrong shape or exceeds a per-widget limit
+    String = 15,    // string longer than MAX_STRING_CHARS characters
+    Field = 16,     // other field with a wrong type or out of range
+};
+
+enum class WidgetType : uint8_t { Text, Value, Bar, Bars, Ring, Spark, Icon, Panel };
+
+struct Rect {
+    int16_t x = 0;
+    int16_t y = 0;
+    int16_t w = 0;
+    int16_t h = 0;
+
+    [[nodiscard]] auto intersects(const Rect& other) const -> bool {
+        return x < other.x + other.w && other.x < x + w && y < other.y + other.h && other.y < y + h;
+    }
+};
+
+struct ScreenConfig {
+    uint16_t bg = DEFAULT_BG;
+    uint8_t bri = DEFAULT_BRI;
+    uint8_t offlineBri = DEFAULT_OFFLINE_BRI;
+    uint32_t pollMs = DEFAULT_POLL_MS;
+    uint32_t offlineDimS = DEFAULT_OFFLINE_DIM_S;
+};
+
+// 12 bytes per widget: what was last drawn, without keeping any JSON around
+struct WidgetSlot {
+    uint32_t idHash = 0;
+    uint32_t rectHash = 0;  // rect and the widget's own "bg"
+    uint32_t contentHash = 0;
+};
+
+struct Frame {
+    ScreenConfig screen;
+    size_t count = 0;
+    std::array<WidgetSlot, MAX_WIDGETS> slots{};
+};
+
+struct ValidationResult {
+    ErrorCode code = ErrorCode::None;
+    int widget = -1;  // index in "w" of the offending widget, -1 for screen-level errors
+};
+
+// FNV-1a, also usable as an ArduinoJson custom writer: serializeJson(obj, writer) hashes without a buffer
+class HashWriter {
+   public:
+    static constexpr uint32_t OFFSET_BASIS = 2166136261U;
+    static constexpr uint32_t PRIME = 16777619U;
+
+    auto write(uint8_t value) -> size_t {
+        m_hash = (m_hash ^ value) * PRIME;
+        return 1;
+    }
+    auto write(const uint8_t* data, size_t length) -> size_t {
+        for (size_t i = 0; i < length; ++i) {
+            write(data[i]);
+        }
+        return length;
+    }
+    [[nodiscard]] auto hash() const -> uint32_t { return m_hash; }
+
+   private:
+    uint32_t m_hash = OFFSET_BASIS;
+};
+
+// Caps what ArduinoJson may read to the announced Content-Length, so a lying server cannot make the
+// parser consume (and allocate for) more than MAX_BODY_BYTES. Uses readBytes() for its timeout.
+template <typename TStream>
+class BoundedReader {
+   public:
+    BoundedReader(TStream& stream, size_t limit) : m_stream(stream), m_remaining(limit) {}
+
+    auto read() -> int {
+        char value = 0;
+        if (m_remaining == 0 || m_stream.readBytes(&value, 1) != 1) {
+            return -1;
+        }
+        --m_remaining;
+        return static_cast<unsigned char>(value);
+    }
+    auto readBytes(char* buffer, size_t length) -> size_t {
+        const size_t wanted = length < m_remaining ? length : m_remaining;
+        const size_t got = wanted == 0 ? 0 : m_stream.readBytes(buffer, wanted);
+        m_remaining -= got;
+        return got;
+    }
+
+   private:
+    TStream& m_stream;
+    size_t m_remaining;
+};
+
+struct Segment {
+    float value = 0;
+    uint16_t color = 0;
+};
+
+struct Segments {
+    std::array<Segment, MAX_SEGMENTS> items{};
+    size_t count = 0;
+    bool isNull = true;
+};
+
+// PC icon body (4-bit values row-major, high nibble first):
+//   mono    'S' 'I' 0x01 w h, ceil(w*h/2) bytes of alpha, drawn in the widget colour
+//   palette 'S' 'I' 0x02 w h n, n <= 16 entries {RGB565 hi, lo, alpha}, ceil(w*h/2) bytes of palette indices
+struct IconHeader {
+    uint8_t format = 0;
+    uint8_t width = 0;
+    uint8_t height = 0;
+    uint8_t paletteCount = 0;
+    uint16_t pixelOffset = 0;  // first byte of the 4-bit pixel data
+    uint16_t totalBytes = 0;   // bytes of the body that are used
+};
+
+// Sparkline height gradient (`grad`): colour stops in sample units, strictly ascending
+struct GradientStop {
+    float value = 0;
+    uint32_t rgb = 0;  // RGB888: interpolation happens before the RGB565 conversion
+};
+
+struct Gradient {
+    std::array<GradientStop, MAX_GRADIENT_STOPS> stops{};
+    size_t count = 0;
+};
+
+struct RingGeometry {
+    int16_t cx = 0;
+    int16_t cy = 0;
+    int16_t radius = 0;     // outer radius R
+    int16_t thickness = 0;  // T
+    int16_t labelY = 0;     // vertical centre of the label
+};
+
+struct Span {
+    int16_t start = 0;
+    int16_t length = 0;
+};
+
+auto fnv1a(const char* text) -> uint32_t;
+auto parseColor(const char* text, uint16_t& out) -> bool;
+auto parseColor888(const char* text, uint32_t& out) -> bool;
+auto rgb565(uint32_t rgb) -> uint16_t;
+auto parseType(const char* text, WidgetType& out) -> bool;
+// Next code point of a UTF-8 string (advances `cursor`); 0xFFFD on malformed input, 0 at the end
+auto decodeUtf8(const char*& cursor) -> uint32_t;
+auto utf8Length(const char* text) -> size_t;
+auto errorName(ErrorCode code) -> const char*;
+
+// Validates a parsed document and fills `frame` (screen settings plus per-widget hashes)
+auto validateDocument(JsonVariantConst root, Frame& frame) -> ValidationResult;
+
+// True when the set of (id, rect, bg) differs, or the screen background changed: needs a full redraw
+auto layoutChanged(const Frame& previous, const Frame& next) -> bool;
+// True when the widget is new or its serialised JSON changed since `previous` was drawn
+auto contentChanged(const Frame& previous, const WidgetSlot& slot) -> bool;
+
+auto readRect(JsonVariantConst value, Rect& out) -> bool;
+auto colorOr(JsonVariantConst value, uint16_t fallback) -> uint16_t;
+// Number, [number, "#colour"], [[number, "#colour"], ...] or null (isNull = true)
+auto readSegments(JsonVariantConst value, uint16_t color, Segments& out) -> bool;
+auto total(const Segments& segments) -> float;
+
+// Fixed-point decimal formatting; writes "--" for values beyond +-1e9
+auto formatNumber(double value, int decimals, char* out, size_t size) -> void;
+
+auto isBuiltinIcon(const char* name) -> bool;
+auto parseIcon(const uint8_t* data, size_t length, IconHeader& out) -> bool;
+// Colour and alpha (0..255, returned) of one pixel; mono icons use `monoColor`
+auto iconPixel(const uint8_t* body, const IconHeader& header, uint8_t column, uint8_t row, uint16_t monoColor,
+               uint16_t& color) -> uint8_t;
+// DISPLAY_URL with its last "/v1/display" (and anything after it) replaced by "/v1/icon/<name>", name
+// percent-encoded; false if the URL has no "/v1/display" or `out` is too small
+auto iconUrl(const char* displayUrl, const char* name, char* out, size_t size) -> bool;
+
+auto ringGeometry(const Rect& rect) -> RingGeometry;
+// Cumulative fraction `value / max` of `length` pixels, clamped to [0, length]
+auto scaleLength(float value, float max, int16_t length) -> int16_t;
+// Slot `index` of `count` equal bars across `extent` pixels with `gap` between them
+auto barSlot(int16_t extent, int16_t gap, size_t count, size_t index) -> Span;
+// Sample y for a sparkline: bottom - (v - min) / (max - min) * (h - 1), clamped to the rect
+auto sparkY(float value, float minValue, float maxValue, const Rect& rect) -> float;
+auto sparkX(size_t index, size_t count, const Rect& rect) -> float;
+// Inverse of sparkY: the sample value a pixel row represents
+auto sparkRowValue(int row, float minValue, float maxValue, const Rect& rect) -> float;
+// `grad` absent: count 0. Errors: Value (shape, 2..8 stops, not ascending), Color (bad "#rrggbb")
+auto readGradient(JsonVariantConst value, Gradient& out) -> ErrorCode;
+// Linear RGB interpolation between the stops around `value`, clamped to the end colours
+auto gradientColor(const Gradient& gradient, float value) -> uint16_t;
+
+}  // namespace renderer
