# Site settings for the build, flash and check tools. Copy to .env (git-ignored) and fill in.
# Variables set in the environment override this file; empty = detect / prompt / default.
# The service itself needs none of this: it detects its LAN address at start (config.example.toml).

# Workstation LAN address compiled into the firmware as the URL to poll.
# Empty = the address carrying the default route. Keep it static (DHCP reservation or manual).
SMALLTV_PC_IP=

# The SmallTV's address on the LAN (web UI, OTA uploads, scripts/watch-display.py).
SMALLTV_DEVICE_IP=

# 2.4 GHz Wi-Fi network the device joins. The password is always prompted, never stored here.
SMALLTV_WIFI_SSID=

# Workstation Wi-Fi interface for the one-time join of the device's own AP (flash-filesystem-via-ap.sh).
# Empty = the first Wi-Fi device NetworkManager reports.
SMALLTV_WIFI_IF=

# Firmware checkout, absolute path (default: GeekMagic-Open-Firmware next to this repository).
FIRMWARE_DIR=
